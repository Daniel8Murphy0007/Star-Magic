        else:         n_s += 1; status = "silent"
        per_row.append({"row": lbl, "orig_sigma": orig, "d_sigma": d,
                        "new_sigma": new, "status": status})
    return {"per_row": per_row, "n_helped": n_h, "n_harmed": n_x, "n_silent": n_s}


