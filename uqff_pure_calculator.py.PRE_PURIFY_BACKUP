    m_k = split["kinematic_consistent"]["wmean_sigma"]
    s_k = split["kinematic_consistent"]["wsig"]
    delta  = m_i - m_k
    joint  = _l46_math.sqrt(s_i * s_i + s_k * s_k)
    tens   = delta / joint if joint > 0 else 0.0
    return {
        "delta_wmean_sigma":  delta,
        "joint_uncertainty":  joint,
        "tension_sigma":      tens,
    }


