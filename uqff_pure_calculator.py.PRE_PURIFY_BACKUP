        "delta_a_exp_rb_x1e13":      da_rb,
        "tension_exp_vs_rb_sigma":   nsig_rb,
        "sign_flip_cs_vs_rb":        nsig_cs * nsig_rb < 0,
        "n_exp":               len(exp),
        "n_sm_cs":             len(sm_cs),
        "n_sm_rb":             len(sm_rb),
    }


