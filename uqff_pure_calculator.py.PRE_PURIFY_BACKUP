        "n_helped":      score["n_helped"],
        "n_harmed":      score["n_harmed"],
        "n_silent":      score["n_silent"],
        "post_wmean":    score["post_wmean"],
        "baseline_wmean": base_wm,
        "absorption_pct": 100.0 * (base_wm - score["post_wmean"]) / base_wm if base_wm > 0 else 0.0,
