        rows.append({
            "label":      label,
            "source":     src,
            "d_sigma":    list(dsig),
            "n_helped":   score["n_helped"],
            "n_harmed":   score["n_harmed"],
            "n_silent":   score["n_silent"],
            "post_wmean": score["post_wmean"],
            "post_wsig":  score["post_wsig"],
            "per_row":    score["per_row"],
