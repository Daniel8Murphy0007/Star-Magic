     "Schöneberg+ 2022 PhysRep 984 1"),
    ("BAO + BBN (Cuceu+ 2019)",           67.60, 1.10, "early",
     "Cuceu+ 2019 JCAP 10 044"),
    ("DESI BAO Y1 + BBN",                 68.53, 0.80, "early",
     "DESI Collab. 2024 arXiv:2404.03002"),
