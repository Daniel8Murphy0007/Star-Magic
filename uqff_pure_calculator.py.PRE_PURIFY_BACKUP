def _l95_fubi_closure_identity(F_UBi: float = 1.0, F_UBi_i: float = 1.0,
                                 F_U: float = 2.0) -> Dict[str, Any]:
    """Inside/outside closure: F_UBi + F_UBi,i == F_U (PAPER_1096)."""
    lhs = F_UBi + F_UBi_i
