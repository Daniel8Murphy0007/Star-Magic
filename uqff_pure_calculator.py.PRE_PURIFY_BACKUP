def _l95_yang_mills_v_conf(r: float = 1.0e-15, sigma: float = 0.18,
                             F_UBi_i: float = 1.0, r0: float = 1.0e-15) -> float:
    """V_conf(r) = sigma r + F_UBi,i (1 - exp(-r/r0)) (PAPER_1111)."""
