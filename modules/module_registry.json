  "formats": {
    "cpp": {
      "extension": ".cpp",
      "loader": "ctypes/pybind11",
      "hot_reload": false,
      "sandbox": true
    },
    "json": {
      "extension": ".json",
      "loader": "json.load",
      "hot_reload": true,
      "sandbox": false
    },
    "python": {
      "extension": ".py",
      "loader": "importlib",
      "hot_reload": true,
      "sandbox": true
    },
    "qt": {
      "extension": ".cpp",
      "loader": "QPluginLoader",
      "hot_reload": false,
      "sandbox": true
    },
    "db": {
      "extension": ".db",
      "loader": "sqlite3/cosmosdb",
      "hot_reload": true,
      "sandbox": true
    },
    "jit": {
      "extension": ".py",
      "loader": "numba/llvmlite",
      "hot_reload": true,
      "sandbox": true
    }
  },
  "communication": {
    "eventbus": {
      "type": "sync",
      "description": "In-process event dispatch"
    },
    "messagequeue": {
      "type": "async",
      "description": "Background task queue"
    },
    "sharedstate": {
      "type": "sync",
      "backend": "redis",
      "description": "Cross-module state sharing"
    },
    "pubsub": {
      "type": "async",
      "protocol": "websocket",
      "description": "Real-time updates"
    }
  }
}
