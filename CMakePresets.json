{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vs2022-x64-windows",
            "displayName": "Visual Studio 2022 x64 (vcpkg + Wolfram WSTP)",
            "description": "Star-Magic UQFF v2.3 - MSVC 14.44, C++20, 659 physics classes, 68 Wolfram companions, SOURCE1-116 integration",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build_msvc",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CMAKE_BUILD_TYPE": "Release",
                "USE_EMBEDDED_WOLFRAM": "ON",
                "CMAKE_CXX_STANDARD": "20"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2022-debug",
            "displayName": "Visual Studio 2022 Debug Build (MAIN_1_CoAnQi)",
            "configurePreset": "vs2022-x64-windows",
            "configuration": "Debug",
            "jobs": 12,
            "targets": ["MAIN_1_CoAnQi"]
        },
        {
            "name": "vs2022-release",
            "displayName": "Visual Studio 2022 Release Build (MAIN_1_CoAnQi + UPX)",
            "configurePreset": "vs2022-x64-windows",
            "configuration": "Release",
            "jobs": 12,
            "targets": ["MAIN_1_CoAnQi"]
        }
    ]
}