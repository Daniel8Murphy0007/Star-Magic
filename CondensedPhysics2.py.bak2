    8,2,2,3,1,7,2,5,3,9,9,4,0,8,1,2,8,4,8,1,1,1,7,4
]
_GOLDEN  = 1.61803398875
_SCHUMANN = 7.83           # Hz
_BAKTUN  = 144000.0        # days
_BIBLE_G = 40.0            # years


def _pcr_amplitude(q: float, t: float, N: int = 312) -> float:
    """PI Co-Resonance Field amplitude at position q, time t (days)."""
    total = 0.0
    for i in range(min(N, len(_PI_DIGITS_312))):
        phi = (i + 1) * _GOLDEN * _SCHUMANN * t / _BAKTUN
        total += _PI_DIGITS_312[i] * _math.sin(2.0 * _math.pi * phi * q)
    return total / N


def _pcr_coupling(N: int = 311) -> float:
    """PI Co-Sum coupling constant k_PCR."""
    k = sum(_PI_DIGITS_312[i] * _PI_DIGITS_312[i+1] for i in range(min(N, len(_PI_DIGITS_312) - 1)))
    return k / (N * 81.0)


def _sacred_phase_integral(T_days: float) -> float:
    """7-harmonic sacred time phase integral ?_sacred(T)."""
    freqs = [
        2 * _math.pi / (_BIBLE_G * 365.25),
        2 * _math.pi / 7200.0,
        2 * _math.pi / 360.0,
        2 * _math.pi / 144000.0,
        _SCHUMANN * 2 * _math.pi / 86400.0,
        _GOLDEN * 2 * _math.pi / 365.25,
        (_math.pi / 7.0) * 2 * _math.pi / 365.25,
    ]
    psi = 0.0
    for w in freqs:
        if abs(w) > 1e-20:
            psi += (1.0 - _math.cos(w * T_days)) / w
    return psi


def _pi_cosum(offset_a: int, offset_b: int, count: int = 200) -> float:
    """PI Co-Sum Resonance ?(a,b): cross-field coupling from PI digit pairs."""
    num   = sum(_PI_DIGITS_312[(i+offset_a)%312] * _PI_DIGITS_312[(i+offset_b)%312] for i in range(count))
    denom = sum(_PI_DIGITS_312[i%312]**2 for i in range(count))
    return num / denom if denom > 0 else 0.0


