# CP4 #258 � UQFFComparedToLIGODataCalculator
# PAPER_674 | Session 173 | appended by _append_cp4_258.py
# ========================================================================
class UQFFComparedToLIGODataCalculator:
    """
    CP4 #258 � PAPER_674 | UQFF vs General LIGO Dataset � chirp mass, h_UQFF(f), phase shift, frequency sweep
    CPP_MODULE: UQFFComparedToLIGOData
    """
    ENTRY   = 258
    PAPER   = "PAPER_674"
    CPP_MODULE = "UQFFComparedToLIGOData"
    UQFF_CONSTANTS = {
        "RHO_UA":  _RHO_VAC_UA,
        "RHO_SCM": _RHO_VAC_SCM,
        "F_TRZ":   0.1,
        "KAPPA":   0.0005,
        "SSQ":     0.57,
        "MU_J":    3.38e23,
        "GAMMA":   5.0e-5 / 86400.0,
    }
    PARAMETERS = [
        ('m1_kg', 'float', 7.16e+31, 'primary BH mass kg'),
        ('m2_kg', 'float', 5.77e+31, 'secondary BH mass kg'),
        ('distance_m', 'float', 1.27e+25, 'luminosity distance m'),
        ('frequency_hz', 'float', 150.0, 'GW frequency Hz'),
    ]
    PRIMARY_OUTPUT = "h_uqff"
    PRIMARY_INPUT  = "frequency_hz"

    def compute(self, params: dict = None) -> dict:
        if params is None:
            params = {}
        defaults = {'m1_kg': 7.16e+31, 'm2_kg': 5.77e+31, 'distance_m': 1.27e+25, 'frequency_hz': 150.0}
        for k, v in defaults.items():
            params.setdefault(k, v)
        m1_kg = params.get('m1_kg', 7.16e+31)
        m2_kg = params.get('m2_kg', 5.77e+31)
        distance_m = params.get('distance_m', 1.27e+25)
        frequency_hz = params.get('frequency_hz', 150.0)
        def chirp_mass(m1, m2):
            return (m1*m2)**0.6 / (m1+m2)**0.2
        def h_GR(Mc, d, f):
            return (4.0/d) * (G*Mc/C**2)**(5.0/3.0) * (PI*f)**(2.0/3.0) / C**2

        M  = m1_kg + m2_kg
        Mc = chirp_mass(m1_kg, m2_kg)
        r  = r_s(M); TH = T_H(M)
        S1 = S_SCm(M, TH, r)
        S2 = S_Um_f(M, r, 1e8, frequency_hz)
        h_gr   = h_GR(Mc, distance_m, frequency_hz)
        h_uqff = (1.0 - F_TRZ) * S1 * S2 * h_gr
        delta_phi = KAPPA * F_TRZ * 1e8
        result = {'h_gr': h_gr, 'h_uqff': h_uqff, 'S_SCm': S1, 'S_Um': S2,
                   'chirp_mass_kg': Mc, 'delta_phi_rad': delta_phi}
        self._last = result
        return result

    def simulate(self, sweep: list = None, sweep_param: str = None) -> list:
        if sweep is None:
            sweep = [{}]
        results = []
        for p in sweep:
            results.append(self.compute(dict(p)))
        return results

    def add_mod(self, fn) -> None:
        if not hasattr(self, "_mods"):
            self._mods = []
        self._mods.append(fn)

    def update_from_file(self, filepath: str) -> None:
        import os
        if not os.path.isfile(filepath):
            return
        with open(filepath, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    try:
                        object.__setattr__(self, k.strip(), float(v.strip()))
                    except ValueError:
                        pass


