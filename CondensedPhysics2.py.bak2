        ('radius_m', 'float', 10000000000.0, 'radial distance from BH m'),
        ('mass_kg', 'float', 8.548e+36, 'BH mass kg (Sgr A*)'),
        ('n_UA', 'float', 2.95e+31, 'aether number density m^-3'),
    ]
    PRIMARY_OUTPUT = "g_eff"
    PRIMARY_INPUT  = "radius_m"

    def compute(self, params: dict = None) -> dict:
        if params is None:
            params = {}
        defaults = {'radius_m': 10000000000.0, 'mass_kg': 8.548e+36, 'n_UA': 2.95e+31}
