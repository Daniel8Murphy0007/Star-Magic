import math as _math

# -- VDS helper used across all Millennium classes -------------------------
def _vds_z26(SSq: float = 0.57, N: int = 26) -> float:
    """Li_26(SSq) = S_{k=1}^{N} SSq^k / k^26  (VDS partial sum)."""
    return sum((SSq ** k) / (k ** 26) for k in range(1, N + 1))


