        "F_TRZ":   0.1,
        "KAPPA":   0.0005,
        "SSQ":     0.57,
        "MU_J":    3.38e23,
        "GAMMA":   5.0e-5 / 86400.0,
    }
    PARAMETERS = [
        ('mass_kg', 'float', 1000000000000.0, 'BH mass kg'),
        ('radius_m', 'float', 0.0, 'evaluation radius m (0=r_s)'),
        ('time_s', 'float', 100000000.0, 'evaluation time s'),
    ]
    PRIMARY_OUTPUT = "T_uqff_K"
    PRIMARY_INPUT  = "mass_kg"

    def compute(self, params: dict = None) -> dict:
        if params is None:
            params = {}
