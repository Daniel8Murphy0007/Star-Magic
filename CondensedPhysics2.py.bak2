class HUDFGalaxiesFUBiICalculator:
    """HUDF Galaxies (z=3.5) F_U_Bi_i universal buoyancy integral.

    Computes the full F_U_Bi_i force for the HUDF cosmic field at cosmological scale.
    Unique: cosmic-scale sigma_n=10^-4 (diffuse IGM), r=1.23e27 m, omega_0=1e-12
    Bridges CP3 HUDFGalaxiesCosmicFieldCalculator result to F_U_Bi_i observational validator.
    Session 72g � PAPER_264-266 pipeline continuity.
    """

    def calculate(self, dataset: dict = None) -> dict:
        import math
        if dataset is None:
            dataset = {}

        G          = 6.6743e-11
        M_sun      = 1.989e30
        hbar       = 1.0546e-34
        mu_B       = 9.274e-24
        c          = 2.998e8
        m_e        = 9.109e-31

        M          = dataset.get('M_Msun',    1e12) * M_sun
        r          = dataset.get('r_m',       1.23e27)       # 1.3e11 ly
        omega_0    = dataset.get('omega_0',   1e-12)
        B_0        = dataset.get('B_T',       1e-10)
        L_X        = dataset.get('L_X_W',     1e35)          # HUDF aggregate X-ray
        theta      = dataset.get('theta_rad', math.pi / 4)
        F_0        = dataset.get('F_0',       1.83e71)
        rho_vac_UA = dataset.get('rho_vac_UA', _RHO_VAC_UA)

        # DPM resonance (IGM field � very small)
        DPM_resonance  = (2.0 * mu_B * B_0) / (hbar * omega_0)

        DPM_stability  = 0.01
        DPM_momentum   = 0.93
        DPM_gravity    = 1.0

        # LENR: 1.25 THz channel
        omega_LENR = 2.0 * math.pi * 1.25e12
        k_LENR     = 1e-10
        F_LENR     = k_LENR * (omega_LENR / omega_0)**2

        # Activation term at 300 Hz
        k_act      = 1e-6
        omega_act  = 2.0 * math.pi * 300.0
        F_act      = k_act * math.cos(omega_act * 0.0)       # t=0 reference

        # Directed energy (scaled by L_X)
        k_DE  = 1e-30
        F_DE  = k_DE * L_X

        # DPM resonance force
        e_charge = 1.602e-19
        V_test   = 1e-3
        F_res    = 2 * e_charge * B_0 * V_test * math.sin(theta) * DPM_resonance

        # Neutron/density term (cosmic IGM: sigma_n=1e-4)
        k_neutron = 1e10
        sigma_n   = 1e-4
        F_neutron = k_neutron * sigma_n                       # = 1e6 N

        # Relativistic term (LEP anchor)
        k_rel          = 1e-10
        E_cm_astro_eff = 1.24e24
        E_cm_LEP       = 189e9
        F_rel          = k_rel * (E_cm_astro_eff / E_cm_LEP)**2

        # Gravity, momentum, vacuum terms
        term_gravity  = (dpm_ug1_seed(M, r)) * DPM_gravity
        term_momentum = (m_e * c**2 / r**2) * DPM_momentum * math.cos(theta)
        term_vac      = rho_vac_UA * DPM_stability

        a_coef       = term_gravity
        b_coef       = 4.72e-3
        c_coef       = -F_0 + term_vac
        discriminant = b_coef**2 - 4.0 * a_coef * c_coef
        x_2 = ((-b_coef - math.sqrt(abs(discriminant))) / (2.0 * a_coef)
               if discriminant >= 0 else F_0 / b_coef)

        integrand = F_LENR + F_act + F_DE + F_res + F_neutron + F_rel
        F_U_Bi_i  = integrand * x_2

        # Buoyancy sign: HUDF omega_0=1e-12 (same equiv class as SN1006+Kepler)
        equiv_class_match = abs(math.log10(abs(F_U_Bi_i)) - math.log10(2.11e208)) < 2.0

        return {
            'primary_equations': [
                f"F_LENR = {F_LENR:.4e} N  [1.25 THz LENR channel, omega_0={omega_0:.0e}]",
                f"F_neutron = {F_neutron:.4e} N  [cosmic IGM sigma_n={sigma_n}]",
                f"F_relativistic = {F_rel:.4e} N  [LEP 1998 anchor]",
                f"integrand = {integrand:.4e} N",
                f"x_2 = {x_2:.4e} m",
                f"F_U_Bi_i = {F_U_Bi_i:.4e} N",
                f"Force Equiv Class match (omega_0=1e-12): {equiv_class_match}",
                f"DPM_resonance (B={B_0:.1e} T) = {DPM_resonance:.4e}",
            ],
            'available_equations': [
                "F_LENR = k_LENR�(omega_LENR/omega_0)�  [LENR 1.25 THz]",
                "F_U_Bi_i = integrand � x_2  [universal buoyancy integral]",
                "x_2 root of a�x�+b�x+c=0; c=-F_0+rho_vac�DPM_stab",
                "Equiv class: omega_0=1e-12 ? F_U_Bi_i�+2.11e208 N",
            ],
            'simulation_set': {
                'omega_0_sweep': 'omega_0: 1e-15?1e-12 � HUDF buoyancy sign transition',
                'B_sweep': 'B: 1e-12?1e11 T � Meissner profile in F_U_Bi_i context',
                'z_evolution': 'HUDF at z=0.5?6 � cosmic F_U_Bi_i evolution',
            },
            'F_U_Bi_i': F_U_Bi_i,
            'F_LENR': F_LENR,
            'F_neutron': F_neutron,
            'DPM_resonance': DPM_resonance,
            'x_2': x_2,
            'equiv_class_match': equiv_class_match,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



