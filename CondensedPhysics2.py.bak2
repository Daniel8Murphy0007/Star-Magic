        ('mass_kg', 'float', 1.293e+40, 'M87* mass kg (6.5e9 Msun)'),
        ('T_acc_K', 'float', 10000000.0, 'accretion disk temperature K'),
    ]
    PRIMARY_OUTPUT = "T_uqff_K"
    PRIMARY_INPUT  = "mass_kg"

    def compute(self, params: dict = None) -> dict:
        if params is None:
            params = {}
        defaults = {'mass_kg': 1.293e+40, 'T_acc_K': 10000000.0}
