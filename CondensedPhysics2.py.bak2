        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



class MUGEResonanceThirteenModeCalculator:
    """PAPER_492 � 13 MUGE resonance frequency modes: aDPM, aTHz, AvacDiff,
    ASuperFreq, AAetherRes, Ug4i, AQuantumFreq, AAetherFreq, AFluidFreq, Osc,
    AExpFreq, fTRZ, Wormhole � plus composite MUGE_Resonance_Total."""

    MODES = ('aDPM', 'aTHz', 'AvacDiff', 'ASuperFreq', 'AAetherRes',
             'Ug4i', 'AQuantumFreq', 'AAetherFreq', 'AFluidFreq',
             'Osc', 'AExpFreq', 'fTRZ', 'Wormhole')

    def calculate(self, M=1.989e30, r=1.5e11, t=0.0):
        import math
        G       = 6.6743e-11
        c       = 2.998e8
        hbar    = 1.055e-34
        beta_i  = 0.6
        f_DPM   = 1e12    # Hz
        f_THz   = 1.2e12  # Hz
        vac_diff = _RHO_VAC_UA
        k_super  = 1.0
        H0       = 2.268e-18
        phi      = 1.618033989
        f_worm   = 1e-18

        # DPM-seeded: mu_s x grad(M_s/r) base (Newtonian form is emergent, not foundational)

        g_base = dpm_ug1_seed(M, r)

        a_DPM         = g_base * math.cos(2 * math.pi * f_DPM * t)
        a_THz         = g_base * math.cos(2 * math.pi * f_THz * t)
        A_vacDiff     = vac_diff * g_base
        a_SuperFreq   = k_super * g_base * math.cos(2 * math.pi * f_DPM * 4 * t)
        a_AetherRes   = beta_i * g_base * math.sin(2 * math.pi * f_DPM * t)
        Ug4i          = 1e-36 * r
        a_QuantumFreq = hbar**2 / (M * r**3) * math.cos(2 * math.pi * f_THz * t)
        a_AetherFreq  = beta_i * g_base * math.cos(2 * math.pi * H0 * t)
        a_FluidFreq   = 1e-4 * G * M / r**3 * math.sin(2 * math.pi * f_THz * t)
        Osc_term      = g_base * math.sin(2 * math.pi * f_DPM * t) * math.cos(2 * math.pi * f_THz * t)
        a_ExpFreq     = phi * g_base * math.exp(-H0 * abs(t)) if t != 0 else phi * g_base
        f_TRZ         = g_base / (1 + math.exp(-beta_i * t)) if t != 0 else g_base / 2.0
        a_wormhole    = f_worm * dpm_ug1_seed(M, r)

        resonance_total = (a_DPM + a_THz + A_vacDiff + a_SuperFreq + a_AetherRes +
                           Ug4i + a_QuantumFreq + a_AetherFreq + a_FluidFreq +
                           Osc_term + a_ExpFreq + f_TRZ + a_wormhole)

        return {
            'primary_equations': {
                'aDPM':          a_DPM,
                'aTHz':          a_THz,
                'AvacDiff':      A_vacDiff,
                'ASuperFreq':    a_SuperFreq,
                'AAetherRes':    a_AetherRes,
                'Ug4i':          Ug4i,
                'AQuantumFreq':  a_QuantumFreq,
                'AAetherFreq':   a_AetherFreq,
                'AFluidFreq':    a_FluidFreq,
                'Osc':           Osc_term,
                'AExpFreq':      a_ExpFreq,
                'fTRZ':          f_TRZ,
                'Wormhole':      a_wormhole,
                'MUGE_Resonance_Total': resonance_total,
                'M': M, 'r': r, 't': t,
            },
            'available_equations': [
                f'aDPM = g_base�cos(2p�f_DPM�t) = {a_DPM:.4e} m/s�',
                f'aTHz = g_base�cos(2p�f_THz�t) = {a_THz:.4e} m/s�',
                f'AvacDiff = ?_vac_diff�g_base = {A_vacDiff:.4e} m/s�',
                f'ASuperFreq = k_super�g_base�cos(4p�f_DPM�t) = {a_SuperFreq:.4e} m/s�',
                f'Wormhole = f_worm�G�M/r� = {a_wormhole:.4e} m/s�',
                f'MUGE_Resonance_Total = S 13 modes = {resonance_total:.4e} m/s�',
            ],
            'simulation_set': [
                {'t': ti, 'M': M, 'r': r} for ti in [0.0, 1e-12, 1e-9, 1e-6, 1e-3]
            ],
        }

