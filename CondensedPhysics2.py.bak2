                            'vexp': 1e5, 'ffluid': 1e11, 't': 1.2e14, 'r': 1.2e11},
                'Pillars': {'I': 1e40, 'A': 1e18, 'omega1': 1e-10, 'Vsys': 1e47,
                            'vexp': 1e4, 'ffluid': 1e9, 't': 1e12, 'r': 9.46e15},
                'Tapestry': {'I': 1e42, 'A': 1e20, 'omega1': 1e-9, 'Vsys': 1e53,
                             'vexp': 1e5, 'ffluid': 1e10, 't': 3.156e13, 'r': 9.46e18},
                'Westerlund2': {'I': 1e44, 'A': 1e22, 'omega1': 1e-7, 'Vsys': 1e56,
                                'vexp': 1e6, 'ffluid': 1e11, 't': 1e13, 'r': 1.5e20},
                'Rings': {'I': 1e48, 'A': 1e24, 'omega1': 1e-5, 'Vsys': 1e60,
