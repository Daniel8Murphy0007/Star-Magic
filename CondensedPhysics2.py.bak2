        "F_TRZ":   0.1,
        "KAPPA":   0.0005,
        "SSQ":     0.57,
        "MU_J":    3.38e23,
        "GAMMA":   5.0e-5 / 86400.0,
    }
    PARAMETERS = [
        ('mass_kg', 'float', 1000000000000.0, 'PBH mass kg'),
        ('n_pbh_m3', 'float', 1000000.0, 'PBH number density m^-3'),
    ]
    PRIMARY_OUTPUT = "f_pbh_boost"
    PRIMARY_INPUT  = "mass_kg"

    def compute(self, params: dict = None) -> dict:
