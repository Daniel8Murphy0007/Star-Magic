class UniversalFieldDecompositionCalculator:
    """PAPER_493 � Full Universal Field F_U decomposition: Ug1 (magnetic dipole),
    Ug2 (charge-reactivity), Ug3 (string rotation), Ug4 (vacuum concentration),
    Ub (buoyancy), Um (magnetism), UA (aether tensor), F_U (unified field total)."""

    def calculate(self, M=1.989e30, r=1.5e11, t=0.0, B=1e-4):
        import math
        G      = 6.6743e-11
        mu_0   = 1.2566e-6    # H/m
        k_1    = 1.5
        k_2    = 1.2
        k_3    = 1.8
        k_4    = 1.0
        beta_i = 0.6
        k_i    = 0.0005       # UQFF calibrated ?
        SSq    = 0.57         # [SSq] calibrated
        hbar   = 1.055e-34
        kappa  = 8 * math.pi * G / (2.998e8**4)
        c      = 2.998e8
        pi     = math.pi

        Ug1 = k_1 * dpm_ug1_seed(M, r)                        # magnetic dipole
        Ug2 = k_2 * beta_i * dpm_ug1_seed(M, r)               # charge-reactivity
        Ug3 = k_3 * (1 - beta_i) * dpm_ug1_seed(M, r)         # string rotation
        Ug4 = k_4 * 1e-36 * r                            # vacuum concentration
        Ub  = beta_i * dpm_ug1_seed(M, r) * math.exp(-SSq * t) if t == 0 else beta_i * dpm_ug1_seed(M, r)
        Um  = (B**2 * 4 * pi * r**2) / (2 * mu_0 * M) if M > 0 else 0.0
        UA  = kappa * c**4 / (G * r**2)
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub + Um + UA

        return {
            'primary_equations': {
                'Ug1': Ug1,
                'Ug2': Ug2,
                'Ug3': Ug3,
                'Ug4': Ug4,
                'Ub':  Ub,
                'Um':  Um,
                'UA':  UA,
                'F_U': F_U,
                'M': M, 'r': r, 't': t, 'B': B,
            },
            'available_equations': [
                f'Ug1 = k_1�G�M/r� = {Ug1:.4e} m/s�',
                f'Ug2 = k_2��_i�G�M/r� = {Ug2:.4e} m/s�',
                f'Ug3 = k_3�(1-�_i)�G�M/r� = {Ug3:.4e} m/s�',
                f'Ug4 = k_4�?_vac�r = {Ug4:.4e} m/s�',
                f'Ub  = �_i�G�M/r��e^(-[SSq]�t) = {Ub:.4e} N/kg',
                f'Um  = B��4pr�/(2�0�M) = {Um:.4e} m/s�',
                f'UA  = ?�c4/(G�r�) = {UA:.4e} m/s�',
                f'F_U = S(Ug1+Ug2+Ug3+Ug4+Ub+Um+UA) = {F_U:.4e} m/s�',
            ],
            'simulation_set': [
                {'name': 'Solar',  'M': 1.989e30,  'r': 1.5e11,  'B': 1e-4},
                {'name': 'Magnetar', 'M': 2.8e30,  'r': 1.0e4,   'B': 1e11},
                {'name': 'SgrA*',  'M': 8.0e36,    'r': 2.5e10,  'B': 1e-3},
                {'name': 'Galaxy', 'M': 1.5e41,    'r': 1.0e21,  'B': 1e-10},
            ],
        }


    def compute(self, dataset: dict = None) -> dict:
        """Stub compute() for data loader/decomposition class."""
        return {'status': 'ok', 'class': type(self).__name__}

class BSMParticleObservablesCalculator:
    """PAPER_494 � Beyond-Standard-Model particle physics observables:
    tau-lepton anomalous magnetic moment ?a_t, CKM Vcb matrix element,
    LFV t?�? branching ratio vs PDG limit, vector-like quark mass coupling term."""

    # PDG 2024 reference values
    CKM_VCB    = 0.0405
    LFV_LIMIT  = 4.2e-13
    A_TAU_SM   = 0.00117721
    M_TAU_KG   = 3.167e-27
    M_VLQ_KG   = 3.56e-25   # ~200 TeV VLQ candidate
    G_VLQ      = 0.1
    M_W_KG     = 1.432e-25  # W boson mass in kg

    def calculate(self, M=1.989e30, r=1.5e11):
        G        = 6.6743e-11
        a_tau_exp = self.A_TAU_SM * 1.0023  # hypothetical measurement offset
        delta_a_tau = abs(a_tau_exp - self.A_TAU_SM)
        BR_ratio    = 1e-14 / self.LFV_LIMIT  # current theoretical prediction vs limit
        VLQ_coupling_term = (self.G_VLQ * G * self.M_VLQ_KG**2
                             / (r**2 * self.M_W_KG)) if r > 0 else 0.0

        return {
            'primary_equations': {
                'delta_a_tau':       delta_a_tau,
                'CKM_Vcb':           self.CKM_VCB,
                'LFV_BR_ratio':      BR_ratio,
                'VLQ_coupling_term': VLQ_coupling_term,
                'a_tau_SM':          self.A_TAU_SM,
                'LFV_PDG_limit':     self.LFV_LIMIT,
                'M_VLQ_kg':          self.M_VLQ_KG,
                'M': M, 'r': r,
            },
            'available_equations': [
                f'?a_t = |a_t(exp) - a_t(SM)| = {delta_a_tau:.6e}',
                f'|Vcb| = {self.CKM_VCB} (PDG 2024)',
                f'BR(t?�?)/BR_PDG_limit = {BR_ratio:.4e}',
                f'g_VLQ�G�M_VLQ�/(r��M_W) = {VLQ_coupling_term:.4e}',
                f'BSM sensitivity scale: {self.M_VLQ_KG * 5.61e35:.2e} GeV',
            ],
            'simulation_set': [
                {'name': 'LHC Baseline',   'M': 1.989e30, 'r': 1.0},
                {'name': 'SgrA* Coupling', 'M': 8.0e36,   'r': 2.5e10},
                {'name': 'Lab scale',      'M': 1.0e-27,  'r': 1.0e-15},
            ],
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
