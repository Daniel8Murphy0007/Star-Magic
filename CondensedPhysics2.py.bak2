class UQFFModulationForM87Calculator:
    """
    CP4 #270 � PAPER_686 | UQFF modulation for M87* � T_UQFF, shadow_UQFF, jet power, ring brightness, T_acc
    CPP_MODULE: UQFFModulationForM87
    """
    ENTRY   = 270
    PAPER   = "PAPER_686"
    CPP_MODULE = "UQFFModulationForM87"
    UQFF_CONSTANTS = {
        "RHO_UA":  _RHO_VAC_UA,
        "RHO_SCM": _RHO_VAC_SCM,
        "F_TRZ":   0.1,
        "KAPPA":   0.0005,
