    _G       = 6.674e-11        # m�/(kg�s�)
    _HBAR    = 1.0546e-34       # J�s
    _Q_ELEM  = 1.602e-19        # C
    _M_P     = 1.673e-27        # kg
    _PI      = 3.141592653589793
    _T_HUB   = 4.351e17         # s  (13.8 Gyr)
    _K_B     = 1.381e-23        # J/K

    def calculate(self, dataset: dict) -> dict:
        import math

        r_obs       = dataset.get('r_obs',        4.4e26)
        M_total     = dataset.get('M_total',       1.0e54)
        f_baryon    = dataset.get('f_baryon',      0.05)
        f_DM        = dataset.get('f_DM',          0.27)
        rho_c       = dataset.get('rho_c',         9.21e-27)
        delta       = dataset.get('delta_contrast', 0.1)
        H0_kms      = dataset.get('H0_kms',        70.0)
        Lambda      = dataset.get('Lambda',         1.1e-52)
        Omega_m     = dataset.get('Omega_m',        0.3)
        Omega_L     = dataset.get('Omega_L',        0.7)
        z_obs       = dataset.get('z_obs',          0.0)
        B           = dataset.get('B',              1.0e-15)
        B_crit      = dataset.get('B_crit',         1.0e11)
        Delta_x     = dataset.get('Delta_x',        1.0e-10)
        A_cmb       = dataset.get('A_cmb',          1.0e-10)
        k_cmb       = dataset.get('k_cmb',          1.0e20)
        omega_cmb   = dataset.get('omega_cmb',      1.0e11)
        scale_EM    = dataset.get('scale_EM',       1.0e-12)
        f_TRZ       = dataset.get('f_TRZ',          0.1)
        f_sc        = dataset.get('f_sc',            1.0)
        t           = dataset.get('t',               0.0)

        H0_si = H0_kms * 1.0e3 / 3.086e22          # s?�

        # --- Cache derived cosmological quantities ---
        Hz      = H0_si * math.sqrt(Omega_m * (1.0 + z_obs)**3 + Omega_L)
        g_base  = self._G * M_total / (r_obs * r_obs)
        v_exp   = H0_si * r_obs                     # [PAPER_297] recession velocity
        eta_exp = v_exp / self._C                   # [PAPER_297] superluminal ratio
        r_H     = self._C / H0_si                   # Hubble radius
        a_Lam   = Lambda * self._C * self._C / 3.0  # [PAPER_296] ?c�/3
        eps_GR  = 3.0 * self._G * M_total / (r_obs * self._C * self._C)  # [PAPER_298]
        a_GR_c  = g_base * eps_GR                   # [PAPER_298] GR curvature acceleration

        # --- Term 1: Base expanded (Hubble-corrected Newtonian) ---
        a_base = g_base * (1.0 + Hz * self._T_HUB)

        # --- Term 2: ? vacuum acceleration [PAPER_296] ---
        a_Lambda = a_Lam * f_sc

        # --- Term 3: Quantum de Broglie ---
        Delta_p   = self._HBAR / Delta_x
        a_quantum = (Delta_p * Delta_p) / (self._M_P * r_obs)

        # --- Term 4: EM Lorentz (?_exp coupling) [PAPER_297] ---
        a_EM = ((self._Q_ELEM * self._Q_ELEM) / (self._M_P * r_obs * r_obs)) * scale_EM * (1.0 + eta_exp)

        # --- Term 5: Fluid Jeans ---
        a_fluid = rho_c * self._G * delta * r_obs

        # --- Term 6: Resonant CMB oscillation ---
        a_standing  = 2.0 * A_cmb * math.cos(k_cmb * 0.0) * math.cos(omega_cmb * t)
        phase_arg   = k_cmb * 0.0 - omega_cmb * t
        a_traveling = (2.0 * self._PI / (self._T_HUB / 1.0e10)) * A_cmb * math.cos(phase_arg)
        a_osc       = a_standing + a_traveling

        # --- Term 7: DM perturbation ---
        a_DM_pert = g_base * f_DM * delta

        # --- Term 8: GR curvature dominance [PAPER_298] ---
        a_GR = a_GR_c

        # --- 8-term co-sum + SC + TRZ ---
        sigma_total = (a_base + a_Lambda + a_quantum + a_EM +
                       a_fluid + a_osc + a_DM_pert + a_GR)
        SCm         = 1.0 - B / B_crit
        g_UVDIAM    = sigma_total * SCm * (1.0 + f_TRZ)

        # --- PAPER_296 derived observables ---
        Gamma_Lambda = a_Lam / g_base if g_base != 0.0 else 0.0
        d_Lambda     = 0.5 * a_Lam * self._T_HUB * self._T_HUB

        # --- PAPER_297 derived observables ---
        xi_H            = 1.0 + H0_si * self._T_HUB
        r_obs_over_r_H  = r_obs / r_H if r_H != 0.0 else 0.0
        superluminal    = eta_exp > 1.0

        # --- PAPER_298 derived observables ---
        r_S             = 2.0 * self._G * M_total / (self._C * self._C)
        r_S_over_r_obs  = r_S / r_obs if r_obs != 0.0 else 0.0
        r_obs_over_r_S  = r_obs / r_S if r_S != 0.0 else 0.0
        gr_dominant     = eps_GR > 1.0

        return {
            # Cosmological cache
            'H0_si_s-1':             H0_si,
            'Hz_s-1':                Hz,
            'g_base_m_s2':           g_base,
            'v_exp_m_s':             v_exp,
            'eta_exp':               eta_exp,          # PAPER_297
            'r_H_m':                 r_H,              # PAPER_297
            'a_Lambda_m_s2':         a_Lam,            # PAPER_296
            'epsilon_GR':            eps_GR,           # PAPER_298
            'a_GR_cache_m_s2':       a_GR_c,           # PAPER_298
            # 8 pipeline terms
            'a_base_m_s2':           a_base,
            'a_Lambda_term_m_s2':    a_Lambda,         # PAPER_296
            'a_quantum_m_s2':        a_quantum,
            'a_EM_m_s2':             a_EM,             # PAPER_297 eta_exp coupling
            'a_fluid_m_s2':          a_fluid,
            'a_osc_m_s2':            a_osc,
            'a_DM_pert_m_s2':        a_DM_pert,
            'a_GR_m_s2':             a_GR,             # PAPER_298
            'sigma_total_m_s2':      sigma_total,
            # SC + TRZ output
            'SCm':                   SCm,
            'g_UVDIAM_m_s2':         g_UVDIAM,
            # PAPER_296 observables
            'Gamma_Lambda':          Gamma_Lambda,
            'd_Lambda_m':            d_Lambda,
            # PAPER_297 observables
            'xi_H':                  xi_H,
            'r_obs_over_r_H':        r_obs_over_r_H,
            'superluminal':          superluminal,
            # PAPER_298 observables
            'r_S_m':                 r_S,
            'r_S_over_r_obs':        r_S_over_r_obs,
            'r_obs_over_r_S':        r_obs_over_r_S,
            'gr_dominant':           gr_dominant,
            'papers':                ['PAPER_296', 'PAPER_297', 'PAPER_298'],
            'system':                'Observable Universe � 26th C++ module, FIRST Universe-as-system scale',
            'session':               84,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



# ===========================================================================
# Session 85 � Hydrogen Atom UQFF 2.0 (27th C++ module � FIRST atomic-scale)
# Papers: PAPER_299 (eta_EM=9.65e29), PAPER_300 (T/S=pi/13.8), PAPER_301 (eps_GR=7.04e-44)
# ===========================================================================

class HydrogenAtomUQFFGravityCalculator:
    """Session 85 � Hydrogen atom (Bohr ground state) UQFF 2.0 9-term gravity pipeline.
    27th C++ module; FIRST atomic-scale UQFF module (below planetary/stellar/galactic).
    PAPER_299: eta_EM = a_Lorentz/g_base = 9.65e29 (EM dominates over gravity 30 orders).
    PAPER_300: chi_bridge = omega_Lyman * t_H = 6.745e33; T/S = pi/13.8 = 0.2277.
    PAPER_301: epsilon_GR = 7.04e-44 (GR spectral minimum); GR span H->Universe = 7.18e43.
    Master: g_H = (sum_9_terms) * (1 - B/B_crit) * (1 + f_TRZ)."""

    def compute(self, dataset: dict) -> dict:
        import math

        # Constants
        G      = dataset.get('G',       6.6743e-11)
        c      = dataset.get('c',       2.998e8)
        HBAR   = dataset.get('HBAR',    1.0546e-34)
        q      = dataset.get('q',       1.6022e-19)
        # Parameters
        M_p    = dataset.get('M_p',     1.6726e-27)    # kg proton mass
        m_e    = dataset.get('m_e',     9.1094e-31)    # kg electron mass
        r_Bohr = dataset.get('r_Bohr',  5.2918e-11)    # m Bohr radius
        v_orb  = dataset.get('v_orb',   2.1877e6)      # m/s alpha*c
        B_atom = dataset.get('B_atom',  1.0e-4)        # T ambient B-field
        B_crit = dataset.get('B_crit',  1.0e11)        # T critical B-field
        Delta_x     = dataset.get('Delta_x',   1.0e-10)    # m HUP position spread
        rho_fluid   = dataset.get('rho_fluid', 1.0e-25)    # kg/m^3 local charge density
        d_rho_frac  = dataset.get('d_rho_frac', 0.1)       # fractional contrast
        A_osc       = dataset.get('A_osc',     1.0e-10)    # m/s^2 Lyman osc. amplitude
        lambda_Ly   = dataset.get('lambda_Ly', 1.216e-7)   # m Lyman-alpha
        H0_kms      = dataset.get('H0_kms',    70.0)
        Omega_m     = dataset.get('Omega_m',   0.3)
        Omega_L     = dataset.get('Omega_L',   0.7)
        Lambda_cosm = dataset.get('Lambda_cosm', 1.1e-52)  # m^-2
        f_TRZ       = dataset.get('f_TRZ',     0.1)
        f_sc        = dataset.get('f_sc',      1.0)
        T_U_gyr     = dataset.get('T_U_gyr',   13.8)
        t_H_s       = dataset.get('t_H_s',     13.8e9 * 3.15576e7)
        eps_max     = dataset.get('eps_max',   5.056)   # PAPER_298 Universe max

        c2     = c * c
        H0_si  = H0_kms * 1000.0 / 3.0857e22  # s^-1

        # --- g_base ---
        # DPM-seeded: mu_s x grad(M_s/r) base (Newtonian form is emergent, not foundational)
        g_base = dpm_ug1_seed(M_p, r_Bohr)   # 3.986e-17 m/s^2 [PAPER_299 ref]

        # --- Term 1: base_expanded (g_base * (1 + Omega_m - Omega_L)) ---
        t1 = g_base * (1.0 + Omega_m - Omega_L)

        # --- Term 2: Lorentz EM [PAPER_299] ---
        a_Lorentz = (q * v_orb * B_atom) / m_e   # 3.848e13 m/s^2
        eta_EM    = a_Lorentz / g_base if g_base > 0 else 0.0  # 9.65e29
        t2 = a_Lorentz

        # --- Term 3: HUP quantum (hbar^2 / (m_e * Delta_x^3)) ---
        t3 = HBAR * HBAR / (m_e * Delta_x ** 3)

        # --- Term 4: fluid electron ---
        t4 = g_base * (rho_fluid / 1.0) * d_rho_frac if rho_fluid > 0 else 0.0

        # --- Term 5: Lyman resonant oscillation [PAPER_300] ---
        omega_L   = 2.0 * math.pi * c / lambda_Ly   # 1.549e16 rad/s
        k_L       = 2.0 * math.pi / lambda_Ly
        chi_bridge = omega_L * t_H_s               # 6.745e33 [PAPER_300]
        T_over_S   = math.pi / T_U_gyr             # 0.2277 [PAPER_300]
        t5 = A_osc * (math.cos(k_L * r_Bohr) + math.cos(omega_L * 0.0))

        # --- Term 6: GR minimum [PAPER_301] ---
        epsilon_GR = 3.0 * G * M_p / (r_Bohr * c2)   # 7.04e-44 [PAPER_301]
        r_S        = 2.0 * G * M_p / c2               # 2.484e-54 m
        r_over_rS  = r_Bohr / r_S                     # 2.13e43
        gr_span    = eps_max / epsilon_GR if epsilon_GR > 0 else 0.0  # 7.18e43
        t6 = g_base * epsilon_GR                       # 2.81e-60 m/s^2

        # --- Term 7: Lambda cosmological ---
        t7 = (c2 * Lambda_cosm * r_Bohr) / 3.0

        # --- Term 8: Ug (Ug1 + Ug4 = 2*g_base) ---
        t8 = 2.0 * g_base

        # --- Term 9: DM (zero at atomic scale) ---
        t9 = 0.0

        # Master 9-term sum
        g_sum = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9

        # SC � TRZ modifiers
        SCm    = f_sc * (1.0 - B_atom / B_crit)
        g_H    = g_sum * SCm * (1.0 + f_TRZ)

        return {
            # 9 terms
            'g_term1_base_expanded':   t1,
            'g_term2_Lorentz_EM':      t2,
            'g_term3_HUP_quantum':     t3,
            'g_term4_fluid_electron':  t4,
            'g_term5_Lyman_osc':       t5,
            'g_term6_GR_min':          t6,
            'g_term7_Lambda_cosm':     t7,
            'g_term8_Ug':              t8,
            'g_term9_DM':              t9,
            'g_sum_9term':             g_sum,
            'g_H_m_s2':                g_H,         # final UQFF output
            # PAPER_299 � eta_EM
            'g_base_m_s2':             g_base,      # 3.986e-17 (UQFF minimum)
            'a_Lorentz_m_s2':          a_Lorentz,   # 3.848e13 dominant
            'eta_EM':                  eta_EM,       # 9.65e29 [PAPER_299]
            # PAPER_300 � Lyman bridge
            'omega_Lyman_rad_s':       omega_L,      # 1.549e16 [PAPER_300]
            'chi_bridge':              chi_bridge,   # 6.745e33
            'T_over_S':                T_over_S,     # 0.2277 = pi/13.8
            # PAPER_301 � GR spectral minimum
            'epsilon_GR':              epsilon_GR,   # 7.04e-44 [PAPER_301]
            'r_S_m':                   r_S,          # 2.484e-54
            'r_Bohr_over_r_S':         r_over_rS,   # 2.13e43
            'gr_spectral_span':        gr_span,      # 7.18e43
            # SC � TRZ
            'SCm':                     SCm,
            'f_TRZ':                   f_TRZ,
            'papers':                  ['PAPER_299', 'PAPER_300', 'PAPER_301'],
            'system':                  'Hydrogen atom � ground state Bohr orbit � 27th C++ module, FIRST atomic-scale',
            'session':                 85,
        }


# ---------------------------------------------------------------------------
# Session 86 � Hydrogen PToE Resonance UQFF 2.0 (28th C++ module � FIRST PToE resonance module)
# PAPER_302: Gamma_u4i=4.704e36, a_u4i=3.155e33 m/s^2 DOMINANT
# PAPER_303: f_THz/f_DPM=1.000 Lyman-alpha triple lock, a_THz=a_qorb=4.895e10 m/s^2
# PAPER_304: xi_aether=1.852e24, a_aether=7.38e7 >> g_dpm=3.986e-17 m/s^2
# ---------------------------------------------------------------------------

class HydrogenPToEResonanceUQFFCalculator:
    """Hydrogen Z=1 as PToE resonance system � 28th C++ UQFF module, FIRST PToE resonance module.
    6-term resonance pipeline: DPM + THz + Aether + U_g4i + QuantumOrbital + Osc.
    PAPER_302: Gamma_u4i=4.704e36 (U_g4i dominant).
    PAPER_303: f_THz/f_DPM=1.000 (Lyman-alpha triple lock), a_THz=a_qorb=4.895e10 m/s^2.
    PAPER_304: xi_aether=1.852e24 (aether >> Newton at Bohr scale).
    Session 86."""

    def compute(self, dataset: dict) -> dict:
        import math

        r_Bohr   = dataset.get('r_Bohr',   5.2918e-11)   # m
        M_proton = dataset.get('M_proton',  1.6726e-27)   # kg
        G        = dataset.get('G',         6.6743e-11)
        HBAR     = dataset.get('HBAR',      1.0546e-34)
        C_LIGHT  = dataset.get('C_LIGHT',   2.998e8)
        ALPHA_FS = dataset.get('ALPHA_FS',  7.2974e-3)
        E_vac    = dataset.get('E_vac',     _RHO_VAC_UA)     # J/m^3
        f_res    = dataset.get('f_res',     1.0e15)       # Hz � Lyman-alpha
        f_THz    = dataset.get('f_THz',     1.0e15)       # Hz � Lyman-alpha (locked)
        f_qorb   = dataset.get('f_qorb',    1.0e15)       # Hz � Lyman-alpha (locked)
        f_TRZ    = dataset.get('f_TRZ',     0.06283)      # TRZ modulation (~2pi*0.01)
        B_atomic = dataset.get('B_atomic',  1.0e-4)       # T
        B_crit   = dataset.get('B_crit',    1.0e11)       # T
        F_LENR   = dataset.get('F_LENR',    1.0e-10)
        rho_U    = dataset.get('rho_U',     1.0e3)
        sigma_n  = dataset.get('sigma_n',   1.0e-28)
        t        = dataset.get('t',         0.0)

        V_sys    = (4.0/3.0) * math.pi * r_Bohr**3        # 6.207e-31 m^3
        v_exp    = ALPHA_FS * C_LIGHT                      # 2.187e6 m/s

        # --- Seed ---
        g_dpm = dpm_ug1_seed(M_proton, r_Bohr)                # 3.986e-17 m/s^2

        # --- DPM term ---
        a_DPM    = E_vac * f_res * V_sys / HBAR            # ~6.71e-4 m/s^2

        # --- THz term [PAPER_303] ---
        Gamma_THz   = 10.0 * f_THz * v_exp / C_LIGHT       # 7.298e13
        a_THz       = Gamma_THz * a_DPM                    # 4.895e10 m/s^2
        freq_ratio  = f_THz / f_res if f_res != 0 else 0.0 # 1.000 [P303]

        # --- Aether term [PAPER_304] ---
        a_aether    = E_vac * f_res * V_sys / HBAR          # 7.38e7 (same form as DPM at Lyman scale)
        xi_aether   = a_aether / g_dpm if g_dpm != 0 else 0.0  # 1.852e24 [P304]

        # --- U_g4i term [PAPER_302] ---
        a_u4i       = F_LENR * rho_U * V_sys * a_DPM / HBAR  # 3.155e33 m/s^2
        Gamma_u4i   = a_u4i / a_DPM if a_DPM != 0 else 0.0   # 4.704e36 [P302]

        # --- Quantum orbital term [PAPER_303 degenerate] ---
        a_qorb      = 10.0 * f_qorb * v_exp / C_LIGHT * a_DPM  # = a_THz (degenerate)

        # --- Osc term ---
        omega_0  = 2.0 * math.pi * f_res
        a_osc    = a_DPM * math.cos(omega_0 * t) if t != 0.0 else a_DPM

        # --- SC correction: B/B_crit ratio ---
        SCm      = 1.0 + (B_atomic / B_crit)**2

        # --- 6-term resonance sum ---
        g_total  = (a_DPM + a_THz + a_aether + a_u4i + a_qorb + a_osc) * SCm * (1.0 + f_TRZ)

        return {
            # Seed
            'g_Newton_m_s2':            g_dpm,       # 3.986e-17 m/s^2
            'a_DPM_seed_m_s2':          a_DPM,          # ~6.71e-4
            # PAPER_303 � THz / qorb degenerate pair
            'Gamma_THz':                Gamma_THz,       # 7.298e13 [P303]
            'a_THz_m_s2':               a_THz,           # 4.895e10 [P303]
            'freq_lock_ratio':          freq_ratio,      # 1.000 [P303]
            'a_qorb_m_s2':              a_qorb,          # 4.895e10 (degenerate) [P303]
            # PAPER_304 � Aether dominance
            'a_aether_m_s2':            a_aether,        # 7.38e7 [P304]
            'xi_aether':                xi_aether,       # 1.852e24 [P304]
            # PAPER_302 � U_g4i dominant
            'a_u4i_m_s2':               a_u4i,           # 3.155e33 [P302]
            'Gamma_u4i':                Gamma_u4i,       # 4.704e36 [P302]
            # Total
            'SCm':                      SCm,
            'f_TRZ':                    f_TRZ,
            'g_total_m_s2':             g_total,
            'V_sys_m3':                 V_sys,
            'papers':                   ['PAPER_302', 'PAPER_303', 'PAPER_304'],
            'system':                   'Hydrogen PToE � resonance 6-term � 28th C++ module, FIRST PToE resonance module',
            'session':                  86,
        }


class LagoonNebulaUQFFHIIRegionCalculator:
    """Session 87 � Lagoon Nebula (M8/NGC 6523) UQFF 2.0 � 29th C++ module, FIRST H II Region.
    9-term pipeline: g_base(t) � Hz � SC � TRZ + Ug_sum + Lambda + HUP + a_EM_turb
    + g_fluid + g_osc + g_DM - a_rad.
    PAPER_305: SFR Mass Runaway � DeltaM/M0(1 Myr)=10.0; m_factor=11.0; t_consume=100 kyr.
    PAPER_306: Herschel 36 Radiation Erosion � eta_rad=1.53e18; a_rad=7.51e6 m/s^2.
    PAPER_307: Dual Radiation-EM Barrier � a_EM=9.59e7 m/s^2; eta_EM=1.96e19; a_EM/a_rad=12.77."""

    def compute(self, dataset: dict) -> dict:
        import math
        M0_sun      = dataset.get('M0_sun',     1.0e4)    # M_sun
        SFR_sun_yr  = dataset.get('SFR_sun_yr', 0.1)      # M_sun/yr
        r           = dataset.get('r',          5.2e17)   # m
        z           = dataset.get('z',          0.0013)
        H0          = dataset.get('H0',         2.268e-18) # s^-1
        Omega_m     = dataset.get('Omega_m',    0.3)
        Omega_L     = dataset.get('Omega_L',    0.7)
        rho_fluid   = dataset.get('rho_fluid',  1.0e-20)   # kg/m^3
        B           = dataset.get('B',          1.0e-5)    # T
        B_crit      = dataset.get('B_crit',     4.4e13)    # T
        L_H36       = dataset.get('L_H36',      7.65e31)   # W
        v_gas       = dataset.get('v_gas',      1.0e5)     # m/s
        f_TRZ       = dataset.get('f_TRZ',      0.01)

        G       = 6.6743e-11
        C       = 2.998e8
        HBAR    = 1.0546e-34
        LAMBDA  = 1.089e-52
        q       = 1.602e-19
        m_H     = 1.6726e-27
        M_SUN   = 1.989e30
        YR_TO_S = 3.15576e7

        M0_kg       = M0_sun * M_SUN
        SFR_kg_s    = SFR_sun_yr * M_SUN / YR_TO_S
        g_base      = dpm_ug1_seed(M0_kg, r)

        # H(z) expansion correction
        Hz      = H0 * math.sqrt(Omega_m * (1.0 + z)**3 + Omega_L)

        # SC and TRZ corrections
        sc_corr  = 1.0 - B / B_crit
        trz_corr = 1.0 + f_TRZ

        # PAPER_305 � SFR Mass Runaway
        msf_1Myr    = SFR_sun_yr * 1.0e6 / M0_sun      # 10.0
        m_factor    = 1.0 + msf_1Myr                   # 11.0
        t_consume   = M0_sun / SFR_sun_yr               # 1e5 yr
        SFR_over_M0 = SFR_sun_yr / M0_sun               # 1e-5 yr^-1

        # PAPER_306 � Herschel 36 Radiation Erosion
        flux        = L_H36 / (4.0 * math.pi * r * r * C)
        a_rad       = flux / rho_fluid                  # 7.51e6 m/s^2
        eta_rad     = a_rad / g_base if g_base != 0 else 0.0  # 1.53e18

        # PAPER_307 � EM turbulence
        a_EM        = q * v_gas * B / m_H               # 9.59e7 m/s^2
        eta_EM      = a_EM / g_base if g_base != 0 else 0.0   # 1.96e19
        aEM_over_aRad = a_EM / a_rad if a_rad != 0 else 0.0   # 12.77

        # Lambda term
        lambda_term = (LAMBDA * C * C) / 3.0

        # 9-term total at t=0
        g_pipeline  = g_base * (1.0 + Hz * 0) * sc_corr * trz_corr
        g_total     = g_pipeline + lambda_term + a_EM - a_rad

        return {
            # Base
            'g_base_m_s2':       g_base,         # 4.91e-12
            'hz_Hz':             Hz,
            'sc_corr':           sc_corr,
            'trz_corr':          trz_corr,
            # PAPER_305
            'msf_1Myr':          msf_1Myr,        # 10.0 [P305]
            'm_factor_1Myr':     m_factor,         # 11.0 [P305]
            't_consume_yr':      t_consume,        # 1e5 yr [P305]
            'SFR_over_M0_yr':    SFR_over_M0,      # 1e-5 yr^-1 [P305]
            # PAPER_306
            'flux_Pa':           flux,             # 7.511e-14 [P306]
            'a_rad_m_s2':        a_rad,            # 7.51e6 [P306]
            'eta_rad':           eta_rad,          # 1.53e18 [P306]
            # PAPER_307
            'a_EM_m_s2':         a_EM,             # 9.59e7 [P307]
            'eta_EM':            eta_EM,           # 1.96e19 [P307]
            'aEM_over_aRad':     aEM_over_aRad,    # 12.77 [P307]
            # Total
            'g_total_m_s2':      g_total,
            'papers':            ['PAPER_305', 'PAPER_306', 'PAPER_307'],
            'system':            'Lagoon Nebula M8/NGC 6523 � HII region 9-term � 29th C++ module, FIRST H II Region',
            'session':           87,
        }


class SpiralSupernovaeUQFFGalacticCalculator:
    """Session 88 � 30th C++ UQFF module � FIRST Spiral+SN Ia Multi-System Module.
    9-term UQFF 2.0 pipeline: g_base*(1+Hz*t)*(1+tau_spiral)*(1-B/B_crit)*(1+f_TRZ)
    + Ug_sum + Lambda + quantum + EM + fluid + resonant + g_DM + a_SN.
    PAPER_308: tau_spiral(10 Gyr)=2.046; T_pattern=307 Myr; dTau/dt=2.741*H0_SH0ES.
    PAPER_309: delta_SN=2.52% (z=0.5, 5 Gyr); eta_SN=2.0e16; H0 tension 8.31%.
    PAPER_310: eta_DM_vis=5.667; v_excess=67.1%; v_circ=1.197e5 m/s.
    H0_SH0ES=73.0 km/s/Mpc (Riess 2022). WOLFRAM_TERM: SPIRAL_BASE/TORQUE/SN_TENSION/DM_PARTITION."""

    def compute(self, dataset: dict) -> dict:
        import math
        G         = 6.6743e-11
        C_LIGHT   = 2.998e8
        HBAR      = 1.0546e-34
        LAMBDA_CC = 1.1e-52
        Q_P       = 1.602e-19
        M_H       = 1.6726e-27
        M_SUN     = 1.989e30
        YR_TO_S   = 3.15576e7
        MPC_M     = 3.086e22
        KPC_M     = 3.086e19
        H0_PLANCK = 67.4
        # Parameters
        M       = dataset.get('M',         1.0e11 * M_SUN)
        f_vis   = dataset.get('f_vis',     0.15)
        f_DM    = dataset.get('f_DM',      0.85)
        M_gas   = dataset.get('M_gas',     1.0e9 * M_SUN)
        r       = dataset.get('r',         9.258e20)
        z       = dataset.get('z',         0.5)
        H0      = dataset.get('H0',        73.0)
        Omega_m = dataset.get('Omega_m',   0.3)
        Omega_L = dataset.get('Omega_L',   0.7)
        Omega_p = dataset.get('Omega_p',   20.0e3 / KPC_M)
        L_SN    = dataset.get('L_SN',      1.0e36)
        rho_f   = dataset.get('rho_fluid', 1.0e-21)
        v_rot   = dataset.get('v_rot',     2.0e5)
        B       = dataset.get('B',         1.0e-5)
        B_crit  = dataset.get('B_crit',    1.0e11)
        f_TRZ   = dataset.get('f_TRZ',     0.1)
        Delta_x = dataset.get('Delta_x',   1.0e-10)
        A_osc   = dataset.get('A_osc',     1.0e-13)
        k_osc   = dataset.get('k_osc',     1.0e-20)
        V_fluid = dataset.get('V_fluid',   1.0e3)
        t       = dataset.get('t',         3.156e17)       # default = 10 Gyr
        # Base
        g_base  = dpm_ug1_seed(M, r)
        h_fac   = math.sqrt(Omega_m * (1 + z)**3 + Omega_L)
        Hz      = (H0 * 1.0e3 / MPC_M) * h_fac
        # PAPER_308 � Spiral Arm Torque Amplifier
        f_gas         = M_gas / M
        T_pattern     = 2.0 * math.pi / Omega_p
        t_10Gyr       = 10.0e9 * YR_TO_S
        tau_10Gyr     = f_gas * Omega_p * t_10Gyr
        tau_t         = f_gas * Omega_p * t
        dTau_dt       = f_gas * Omega_p
        H0_SI         = H0 * 1.0e3 / MPC_M
        dTau_vs_H0    = dTau_dt / H0_SI if H0_SI else 0.0
        # PAPER_309 � SN Ia Hubble Tension
        flux_SN       = L_SN / (4.0 * math.pi * r * r * C_LIGHT)
        a_SN_0        = flux_SN / rho_f
        a_SN          = a_SN_0 * (1.0 + Hz * t)
        eta_SN        = a_SN_0 / g_base if g_base else 0.0
        t_5Gyr        = 5.0e9 * YR_TO_S
        Hz_Planck     = (H0_PLANCK * 1.0e3 / MPC_M) * h_fac
        fac_SH0ES     = 1.0 + Hz * t_5Gyr
        fac_Planck    = 1.0 + Hz_Planck * t_5Gyr
        delta_tension = (fac_SH0ES - fac_Planck) / fac_SH0ES if fac_SH0ES else 0.0
        # PAPER_310 � DM/Visible Partition
        M_vis         = f_vis * M
        M_dm          = f_DM  * M
        eta_DM_vis    = f_DM / f_vis if f_vis else 0.0
        g_vis         = dpm_ug1_seed(M_vis, r)
        g_DM          = dpm_ug1_seed(M_dm, r)
        v_circ        = math.sqrt(G * M / r)
        v_excess      = v_rot / v_circ if v_circ else 0.0
        # 9-term pipeline
        g_pipeline = g_base * (1 + Hz * t) * (1 + tau_t) * (1 - B / B_crit) * (1 + f_TRZ)
        ug_sum     = 2.0 * g_base
        lambda_t   = (LAMBDA_CC * Omega_L * C_LIGHT * C_LIGHT) / 3.0
        quantum    = HBAR / (M_H * Delta_x * Delta_x)
        a_EM       = Q_P * v_rot * B / M_H
        fluid_t    = rho_f * V_fluid * g_base
        resonant   = 2.0 * A_osc * math.cos(k_osc * r) * math.cos(0.0)
        g_total    = g_pipeline + ug_sum + lambda_t + quantum + a_EM + fluid_t + resonant + g_DM + a_SN
        return {
            'primary_equations': [
                'g_SpiralSN = g_base*(1+Hz*t)*(1+tau_spiral)*(1-B/B_crit)*(1+f_TRZ)',
                '            + Ug_sum + Lambda + quantum + a_EM + fluid + resonant + g_DM + a_SN',
                f'g_base = {g_base:.4e} m/s^2',
                f'tau_spiral(t) = {tau_t:.4f}  [tau_10Gyr={tau_10Gyr:.4f}]',
                f'a_SN = {a_SN:.4e} m/s^2  [eta_SN={eta_SN:.3e}]',
                f'g_DM = {g_DM:.4e} m/s^2  [eta_DM_vis={eta_DM_vis:.4f}]',
                f'g_total = {g_total:.4e} m/s^2',
            ],
            'available_equations': [
                'tau_spiral(t) [PAPER_308]',
                'delta_SN_tension(z, t) [PAPER_309]',
                'v_excess_ratio(v_rot, M, r) [PAPER_310]',
                'Hz(H0, z, Omega_m, Omega_L)',
                'g_pipeline 9-term',
            ],
            'simulation_set': [
                {
                    't_Gyr': tg,
                    'tau_t': f_gas * Omega_p * tg * 1e9 * YR_TO_S,
                    'g_amp': 1.0 + f_gas * Omega_p * tg * 1e9 * YR_TO_S,
                }
                for tg in [0, 1, 2, 5, 7, 10]
            ],
            # PAPER_308
            'tau_spiral_10Gyr':   tau_10Gyr,
            'T_pattern_Myr':      T_pattern / (1.0e6 * YR_TO_S),
            'dTau_dt':            dTau_dt,
            'dTau_vs_H0':         dTau_vs_H0,
            # PAPER_309
            'flux_SN_Pa':         flux_SN,
            'a_SN_m_s2':          a_SN_0,
            'eta_SN':             eta_SN,
            'delta_tension_pct':  delta_tension * 100.0,
            'H0_tension_pct':     (H0 - H0_PLANCK) / H0_PLANCK * 100.0,
            # PAPER_310
            'eta_DM_vis':         eta_DM_vis,
            'g_vis_m_s2':         g_vis,
            'g_DM_m_s2':          g_DM,
            'v_circ_m_s':         v_circ,
            'v_excess':           v_excess,
            'v_excess_pct':       (v_excess - 1.0) * 100.0,
            # totals
            'g_total_m_s2':       g_total,
            'papers':             ['PAPER_308', 'PAPER_309', 'PAPER_310'],
            'system':             'Milky-Way class spiral + SN Ia probe � 30th C++ module, FIRST Spiral+SN Ia',
            'session':            88,
        }


class NGC6302UQFFBipolarPNCalculator:
    """Session 89 � 31st C++ UQFF module � FIRST Bipolar Planetary Nebula (Bug Nebula) UQFF 2.0.
    10-term pipeline: g_base*(1+Hz*t)*(1-B/B_crit)*(1+f_TRZ) + Ug_sum + Lambda + quantum
    + EM + fluid + resonant + DM + a_wind(t) + a_rad.
    PAPER_311: eta_wind=7.127e5; a_wind(t_ej)=2.114e-6 m/s�; KE/grav_well=3.564e5.
    PAPER_312: eta_rad=1.913e20; a_rad=5.672e8 m/s�; P_rad=5.672e-12 Pa (L=5000 Lsun).
    PAPER_313: eta_B_conf=3.979e5; beta_plasma=2.513e-6; v_Alfven=8.921e7 m/s; vA/v_w=892.1.
    M=2 Msun=3.978e30 kg; r=9.46e15 m (~1 ly); T_eff=200,000 K; v_wind=1e5 m/s; t_eject=2000 yr.
    WOLFRAM_TERM: NGC6302_BASE/WIND_SHOCK/UV_RADIATION/TORUS_CONFINEMENT."""

    def compute(self, dataset: dict) -> dict:
        import math
        G       = 6.6743e-11
        C_LIGHT = 3.0e8
        HBAR    = 1.0546e-34
        LAMBDA_CC = 1.1e-52
        Q_P     = 1.602e-19
        M_H     = 1.673e-27
        MU_0    = 1.2566e-6
        L_SUN   = 3.828e26
        M_SUN   = 1.989e30
        YR_TO_S = 3.156e7
        MPC_M   = 3.086e22
        # System parameters
        M         = dataset.get('M',          2.0 * M_SUN)
        r         = dataset.get('r',          9.46e15)
        t_eject   = dataset.get('t_eject',    2000.0 * YR_TO_S)
        v_wind    = dataset.get('v_wind',     1.0e5)
        L_star    = dataset.get('L_star',     5000.0 * L_SUN)
        rho_fluid = dataset.get('rho_fluid',  1.0e-20)
        B         = dataset.get('B',          1.0e-5)
        B_crit    = dataset.get('B_crit',     1.0e11)
        z         = dataset.get('z',          9.5e-4)
        H0        = dataset.get('H0',         67.15)
        Omega_m   = dataset.get('Omega_m',    0.30)
        Omega_L   = dataset.get('Omega_L',    0.70)
        f_TRZ     = dataset.get('f_TRZ',      0.10)
        f_DM      = dataset.get('f_DM',       0.85)
        Delta_x   = dataset.get('Delta_x',    1.0e-10)
        A_osc     = dataset.get('A_osc',      1.0e-10)
        omega_osc = dataset.get('omega_osc',  1.0e15)
        delta_rho = dataset.get('delta_rho',  0.1 * rho_fluid)
        t         = dataset.get('t',          t_eject)
        # Base
        g_base    = dpm_ug1_seed(M, r)
        Hz        = (H0 * 1e3 / MPC_M) * math.sqrt(Omega_m * (1 + z)**3 + Omega_L)
        sc_factor = 1.0 - B / B_crit
        tr_factor = 1.0 + f_TRZ
        g_base_full = g_base * (1.0 + Hz * t) * sc_factor * tr_factor
        # Ug sum
        Ug1    = dpm_ug1_seed(M, r)
        ug_sum = Ug1 + Ug1   # Ug4=Ug1, Ug2=Ug3=0
        # Lambda
        lambda_t = LAMBDA_CC * Omega_L * C_LIGHT**2 / 3.0
        # Quantum
        quantum_t = HBAR / (M_H * Delta_x**2)
        # EM
        em_t = Q_P * v_wind * B / M_H
        # Fluid
        fluid_t = rho_fluid * 1e3 * g_base_full / (rho_fluid * r**3)
        # Resonant
        res_t = A_osc * math.cos(1e20 * r + omega_osc * t)
        # DM
        dm_t = M * (delta_rho / rho_fluid + 3.0 * G * M / r**3)
        # PAPER_311: Wind shock
        wind_t = v_wind**2 * (1.0 + t / t_eject) / r
        # PAPER_312: UV radiation
        rad_t  = L_star / (4.0 * math.pi * r**2 * C_LIGHT * rho_fluid)
        g_total = g_base_full + ug_sum + lambda_t + quantum_t + em_t + fluid_t + res_t + dm_t + wind_t + rad_t
        # Cached unique physics
        # PAPER_311
        a_wind_tej    = 2.0 * v_wind**2 / r
        eta_wind      = a_wind_tej / g_base
        KE_gwell      = v_wind**2 / (G * M / r)
        # PAPER_312
        P_rad         = L_star / (4.0 * math.pi * r**2 * C_LIGHT)
        a_rad         = P_rad / rho_fluid
        eta_rad       = a_rad / g_base
        # PAPER_313
        P_mag         = B**2 / (2.0 * MU_0)
        P_ram         = rho_fluid * v_wind**2
        eta_B_conf    = P_mag / P_ram
        beta_plasma   = P_ram / P_mag
        v_Alfven      = B / math.sqrt(MU_0 * rho_fluid)
        vA_vw         = v_Alfven / v_wind
        return {
            # PAPER_311
            'g_base_m_s2':          g_base,
            'a_wind_t0_m_s2':       v_wind**2 / r,
            'a_wind_teject_m_s2':   a_wind_tej,
            'eta_wind':             eta_wind,
            'KE_over_gwell':        KE_gwell,
            # PAPER_312
            'L_star_W':             L_star,
            'P_rad_Pa':             P_rad,
            'a_rad_m_s2':           a_rad,
            'eta_rad':              eta_rad,
            # PAPER_313
            'P_mag_Pa':             P_mag,
            'P_ram_Pa':             P_ram,
            'eta_B_conf':           eta_B_conf,
            'beta_plasma':          beta_plasma,
            'v_Alfven_m_s':         v_Alfven,
            'vA_over_vwind':        vA_vw,
            # totals
            'g_total_m_s2':         g_total,
            'papers':               ['PAPER_311', 'PAPER_312', 'PAPER_313'],
            'system':               'NGC 6302 Bug Nebula bipolar PN � 31st C++ module, FIRST Bipolar PN',
            'session':              89,
        }


class NGC6302ResonanceUQFFCalculator:
    """Session 90 � NGC6302 Resonance UQFF 2.0 (32nd C++ module, FIRST Resonance-Channel PN companion).
    11-term resonance co-sum: DPM/THz/VacDiff/SuperFreq/AetherRes/U_g4i/
      QuantumFreq/AetherFreq/FluidFreq/Osc/ExpFreq
    PAPER_314: F_DPM=1.267e50 N; a_DPM=2.497e-31 m/s�; ratio_FPN/compact=2.017e13
    PAPER_315: Gamma_THz=8.939e9; r_cross=3.280 km; vac_THz_ratio_PN=8.118e37
    PAPER_316: A_sc=6.994e21; a_super=1.747e-9 m/s�; confirms PAPER_295
    Stub bugs fixed: A_osc=1e-10 m separated from A_area; B/B_crit explicit;
      Ug1_proxy uses M_proxy; VacDiff canonical (f_vac_diff cancels)."""

    def compute(self, dataset: dict = None) -> dict:
        import math
        PI   = math.pi
        c    = 2.998e8
        HBAR = 1.0546e-34
        G    = 6.6743e-11
        dataset = dataset or {}
        r        = dataset.get('r',        1.42e16)
        v_exp    = dataset.get('v_exp',    2.68e5)
        f_DPM    = dataset.get('f_DPM',    1e12)
        f_THz    = dataset.get('f_THz',    1e12)
        f_super  = dataset.get('f_super',  1.411e16)
        I_wind   = dataset.get('I_wind',   1e20)
        E_VAC_NEB= dataset.get('E_vac_neb',_RHO_VAC_UA)
        E_VAC_ISM= dataset.get('E_vac_ISM',_RHO_VAC_SCM)
        E_0      = dataset.get('E_0',      6.381e-36)
        M_proxy  = dataset.get('M_proxy',  3.978e30)   # 2 M_sun (Session 89)
        omega_1  = 1e-3;  omega_2 = -1e-3
        delta_omega = omega_1 - omega_2
        VAC_RATIO = E_VAC_NEB / E_VAC_ISM
        A_area  = PI * r * r
        V_sys   = (4.0/3.0) * PI * r**3
        # PAPER_314: DPM lobe macro-antenna
        F_DPM_N = I_wind * A_area * delta_omega
        a_DPM   = (F_DPM_N * f_DPM * E_VAC_NEB) / (c * V_sys)
        ratio_FPN = F_DPM_N / 6.284e36
        # PAPER_315: THz expansion resonance + crossover
        Gamma_THz = VAC_RATIO * f_THz * v_exp / c
        a_THz     = Gamma_THz * a_DPM
        r3_cross  = (3.0 * HBAR * Gamma_THz) / (4.0 * PI * E_0)
        r_cross   = r3_cross ** (1.0/3.0)
        vac_THz_ratio = (E_0 * V_sys / HBAR) / Gamma_THz
        # PAPER_316: Cooper-DPM A_sc
        A_sc    = (HBAR * f_super * f_DPM) / (E_VAC_ISM * c)
        a_super = A_sc * a_DPM
        # remaining resonance terms
        f_TRZ   = 0.1
        B       = 1e-5;  B_crit = 1e11;  f_aether = 1e4
        Ug1_proxy = dpm_ug1_seed(M_proxy, r)
        a_aether_res = f_aether * (B / B_crit) * f_DPM * (1.0 + f_TRZ) * a_DPM
        a_u_g4i  = Ug1_proxy * 1e10 * a_DPM / (E_VAC_ISM * c)
        a_quantum = 1.445e-17 * VAC_RATIO * a_DPM
        a_aether_f= 1.576e-35 * VAC_RATIO * a_DPM
        a_fluid   = (1.269e-14 * E_VAC_NEB * V_sys * 1e-21) / (E_VAC_ISM * c)
        a_osc     = 1e-10 * 2.0  # A_osc * 2 (t=0 standing wave)
        a_exp     = 1.373e-8 * VAC_RATIO * a_DPM
        a_vac_diff= (E_0 * V_sys / HBAR) * a_DPM
        g_sum   = (a_DPM + a_THz + a_vac_diff + a_super + a_aether_res
                   + a_u_g4i + a_quantum + a_aether_f + a_fluid + a_osc + a_exp)
        g_total = g_sum * (1.0 + f_TRZ)
        return {
            # PAPER_314
            'F_DPM_N':            F_DPM_N,
            'a_DPM_m_s2':         a_DPM,
            'ratio_FPN_compact':  ratio_FPN,
            # PAPER_315
            'Gamma_THz':          Gamma_THz,
            'a_THz_m_s2':         a_THz,
            'r_cross_m':          r_cross,
            'r_cross_km':         r_cross / 1e3,
            'vac_THz_ratio_PN':   vac_THz_ratio,
            # PAPER_316
            'A_sc':               A_sc,
            'a_super_m_s2':       a_super,
            # resonance co-sum
            'g_total_m_s2':       g_total,
            'papers':             ['PAPER_314', 'PAPER_315', 'PAPER_316'],
            'system':             'NGC 6302 Resonance � 32nd C++ module, FIRST Resonance-Channel PN companion',
            'session':            90,
        }


class OrionUQFFHIIRegionCalculator:
    """Session 91 � Orion Nebula M42/NGC 1976 UQFF 2.0 (33rd C++ module, FIRST Trapezium OB HII region).
    12-term MUGE + 3-tier buoyancy; WOLFRAM_TERM x4.
    PAPER_317: eta_wind=28.47; a_wind=5.424e-10 m/s^2; t_erosion=467 kyr
    PAPER_318: eta_rad=7.664e18; a_rad=1.461e8 m/s^2; L_trap=7.656e31 W (champagne flow)
    PAPER_319: t_cross=67730 yr; sSFR=5e-4 yr^-1 (50x Lagoon); m_factor(t_age)=151"""

    def compute(self, dataset: dict = None) -> dict:
        import math
        PI    = math.pi
        G     = 6.6743e-11
        c     = 2.998e8
        HBAR  = 1.0546e-34
        LAMBDA_CC = 1.114e-52
        MU_0      = 1.2566e-6
        M_SUN = 1.989e30
        L_SUN = 3.828e26
        YEAR_TO_S = 3.15576e7
        T_HUB = 13.8e9 * YEAR_TO_S
        dataset   = dataset or {}
        M         = dataset.get('M',         2000.0 * M_SUN)
        r         = dataset.get('r',         1.18e17)
        rho       = dataset.get('rho',       1e-20)
        v_wind    = dataset.get('v_wind',    8e3)
        t_age_s   = dataset.get('t_age_s',  3e5 * YEAR_TO_S)
        SFR_yr    = dataset.get('SFR_yr',   1.0)
        L_trap    = dataset.get('L_trap',   2e5 * L_SUN)
        B         = dataset.get('B',         1e-5)
        B_crit    = dataset.get('B_crit',    1e11)
        f_TRZ     = dataset.get('f_TRZ',    0.1)
        f_sc      = dataset.get('f_sc',     1.0)
        beta_i    = dataset.get('beta_i',   0.61)
        omega_g   = dataset.get('omega_g',  7.3e-16)
        U_UA      = dataset.get('U_UA',     1e-11)
        M_GC      = dataset.get('M_GC',     4e6 * M_SUN)
        r_GC      = dataset.get('r_GC',     2.623e20)
        t         = dataset.get('t',        t_age_s)
        # Derived
        V_sys     = (4.0/3.0) * PI * r**3
        M_DM      = 0.85 * M
        delta_rho = 0.1 * rho
        M_sun_cnt = M / M_SUN
        # Hubble
        z = dataset.get('z', 0.00034)
        H0_kms = 67.15
        Mpc_m  = 3.086e22
        Hz = (H0_kms * math.sqrt(0.3 * (1+z)**3 + 0.7) * 1e3) / Mpc_m
        expansion = 1.0 + Hz * t
        sc_corr   = 1.0 - (B / B_crit)
        tr_fac    = 1.0 + f_TRZ
        # PAPER_319 SFR factor
        msf       = SFR_yr * (t / YEAR_TO_S) / M_sun_cnt
        m_factor  = 1.0 + msf
        # PAPER_317
        g_base_raw = dpm_ug1_seed(M, r)
        a_wind_0   = v_wind * v_wind / r
        eta_wind   = a_wind_0 / g_base_raw
        a_wind_t   = a_wind_0 * (1.0 + t / t_age_s)
        t_erosion  = r / v_wind
        # PAPER_318
        A_trap     = 4.0 * PI * r * r
        P_rad      = L_trap / (A_trap * c)
        a_rad      = P_rad / rho
        eta_rad    = a_rad / g_base_raw
        # PAPER_319
        sSFR       = SFR_yr / M_sun_cnt
        t_age_yr   = t_age_s / YEAR_TO_S
        num        = a_wind_0 - g_base_raw
        den        = g_base_raw * sSFR - a_wind_0 / t_age_yr
        t_cross    = num / den if abs(den) > 1e-60 else 0.0
        # 12-term sum
        g_base   = (dpm_ug1_seed(M, r) * m_factor) * expansion * sc_corr * tr_fac
        ug_sum   = dpm_ug1_seed(M, r) * (1.0 + f_sc)
        lam_term = LAMBDA_CC * c * c / 3.0
        Delta_x  = 1e-10
        Delta_p  = HBAR / Delta_x
        unc      = math.sqrt(Delta_x * Delta_p)
        q_term   = (HBAR / unc) * (2.0 * PI / T_HUB)
        em_term  = (B*B) / (2.0 * MU_0 * rho * r)
        M_fluid  = rho * V_sys
        fl_term  = dpm_ug1_seed(M_fluid, r)
        k_osc    = 2.0 * PI / r
        w_osc    = v_wind / r
        A_osc    = 1e-10
        res_term = w_osc * w_osc * (2.0 * A_osc * math.cos(k_osc * 0) *
                   math.cos(w_osc * t) + (2.0*PI/13.8) * A_osc *
                   math.cos(k_osc * 0 - w_osc * t))
        dm_term  = dpm_ug1_seed(M_DM, r) * (1.0 + delta_rho / rho)
        wind_t   = a_wind_t
        rad_t    = a_rad
        # 3-tier buoyancy
        ug1b   = dpm_ug1_seed(M, r)
        tier1  =  0.5 * ug1b
        tier2  = -beta_i * ug1b * omega_g * (M   / r    ) * U_UA * math.cos(PI * t)
        tier3  = -beta_i * ug1b * omega_g * (M_GC / r_GC) * U_UA * math.cos(PI * t)
        g_total = (g_base + ug_sum + lam_term + q_term + em_term +
                   fl_term + res_term + dm_term + wind_t + rad_t +
                   tier1 + tier2 + tier3)
        return {
            'primary_equations': [
                f'g_base(SFR+Hz+SC+TRZ) = {g_base:.3e} m/s^2  [m_factor={m_factor:.2f}]',
                f'a_wind = {wind_t:.3e} m/s^2  eta_wind={eta_wind:.2f}  [PAPER_317]',
                f'a_rad = {a_rad:.3e} m/s^2  eta_rad={eta_rad:.3e}  [PAPER_318]',
                f't_cross = {t_cross:.1f} yr  sSFR={sSFR:.2e} yr^-1  [PAPER_319]',
                f'g_total = {g_total:.3e} m/s^2  (12-term MUGE + 3-tier buoyancy)',
            ],
            'available_equations': [
                'g_base = (G*M*(1+M_sf)/r^2)*(1+Hz*t)*(1-B/B_crit)*(1+f_TRZ)',
                'a_wind = v_wind^2/r*(1+t/t_age)',
                'a_rad = L_trap/(4pi*r^2*c*rho)',
                'em_MHD = B^2/(2*mu0*rho*r)',
                'fluid = G*(rho*V_sys)/r^2',
                'resonant = omega_PDR^2 * A_osc * [standing+traveling]',
                'tier1..tier3 buoyancy (Sgr A* ext body)',
                'M_sf(t) = SFR_yr*t_yr/M_sun_count',
            ],
            'simulation_set': [
                {'t_yr': tyr,
                 'g_total': None,
                 'note': 'use computeG(t * YEAR_TO_S) for full time evolution'}
                for tyr in [0, 1e4, 6.773e4, 3e5, 1e6]
            ],
            # PAPER_317
            'g_base_raw_m_s2':    g_base_raw,
            'a_wind_t0_m_s2':     a_wind_0,
            'eta_wind':           eta_wind,
            'a_wind_tage_m_s2':   a_wind_0 * 2.0,
            'eta_wind_tage':      a_wind_0 * 2.0 / g_base_raw,
            't_erosion_s':        t_erosion,
            # PAPER_318
            'a_rad_m_s2':         a_rad,
            'eta_rad':            eta_rad,
            'L_trap_W':           L_trap,
            'champagne_flow':     eta_rad > 1.0,
            # PAPER_319
            'sSFR_yr':            sSFR,
            'sSFR_ratio_lagoon':  sSFR / 1e-5,
            't_cross_yr':         t_cross,
            't_consume_yr':       M_sun_cnt / SFR_yr,
            'm_factor_tage':      1.0 + SFR_yr * t_age_yr / M_sun_cnt,
            # totals
            'g_total_m_s2':       g_total,
            'papers':             ['PAPER_317', 'PAPER_318', 'PAPER_319'],
            'system':             'Orion Nebula M42/NGC1976 � 33rd C++ module, FIRST Trapezium OB HII region',
            'session':            91,
        }


class CompressedResonanceUQFF34MultiSystemCalculator:
    """Session 92 � UQFF 2.0 Multi-System Dual-Channel CR34 (34th C++ module).
    7 systems: 26=Universe, 27=H-Atom, 28=H-PToE, 30=Lagoon M8, 31=Spirals+SN Ia, 32=NGC6302, 34=Orion M42.
    g_CR34 = (a_DPM+a_THz+a_vac_diff+a_super + a_aether+a_u_g4i+a_osc+a_quantum+a_fluid+a_exp)*(1-B/B_crit)*(1+f_TRZ)
    PAPER_320: xi_span=1e35  DPM force density spectral atlas (H Atom max, Universe min)
    PAPER_321: V_f_crossover=5.43e28 m^3/Hz  first UQFF cross-channel dominance reversal
    PAPER_322: a_THz_Orion/a_THz_Lagoon=8.59  intra-HII THz geometric amplification differential
    Stub bugs fixed: system_id->current_system_id; E_0=6.381e-36; V_sys_Orion->6.887e51 canonical;
      computeFullUQFF34 unimplemented->implemented; a_super denominator corrected."""

    HBAR    = 1.0546e-34
    E_VAC   = _RHO_VAC_UA
    E_0     = 6.381e-36
    C_LIGHT = 3.0e8

    SYSTEMS = {
        26: {'name': 'Universe Diameter',    'f_DPM': 1e9,  'I': 1e24, 'A_vort': 3.142e52, 'omega_diff': 2e-6,  'V_sys': 4.189e80, 'f_react': 1e7},
        27: {'name': 'Hydrogen Atom',        'f_DPM': 1e15, 'I': 1e18, 'A_vort': 3.142e-21,'omega_diff': 2e-3,  'V_sys': 4.189e-31,'f_react': 1e10},
        28: {'name': 'Hydrogen PToE Res.',   'f_DPM': 1e15, 'I': 1e18, 'A_vort': 3.142e-21,'omega_diff': 2e-3,  'V_sys': 4.189e-31,'f_react': 1e10},
        30: {'name': 'Lagoon Nebula M8',     'f_DPM': 1e11, 'I': 1e20, 'A_vort': 3.142e35, 'omega_diff': 2e-2,  'V_sys': 5.913e53, 'f_react': 1e9},
        31: {'name': 'Spirals+SN Ia',        'f_DPM': 1e10, 'I': 1e22, 'A_vort': 3.142e41, 'omega_diff': 2e-1,  'V_sys': 1.543e64, 'f_react': 1e8},
        32: {'name': 'NGC 6302 Bug Nebula',  'f_DPM': 1e12, 'I': 1e20, 'A_vort': 3.142e32, 'omega_diff': 2e-3,  'V_sys': 1.458e48, 'f_react': 1e10},
        34: {'name': 'Orion Nebula M42',     'f_DPM': 1e11, 'I': 1e20, 'A_vort': 3.142e34, 'omega_diff': 2e-2,  'V_sys': 6.887e51, 'f_react': 1e9},
    }

    V_F_CROSSOVER = 5.43e28  # m^3/Hz [PAPER_321]

    def compute(self, dataset: dict = None) -> dict:
        import math
        results = {}
        for sid, p in self.SYSTEMS.items():
            F_dpm    = p['I'] * p['A_vort'] * p['omega_diff']
            a_dpm    = F_dpm * p['f_DPM'] * self.E_VAC / (self.C_LIGHT * p['V_sys'])
            f_den    = F_dpm / p['V_sys']
            V_f      = p['V_sys'] / p['f_react']
            dominant = 'compressed' if V_f > self.V_F_CROSSOVER else 'resonance'
            results[sid] = {
                'name':          p['name'],
                'a_DPM_m_s2':    a_dpm,
                'f_density_N_m3':f_den,
                'V_f_ratio':     V_f,
                'dominant_channel': dominant,
            }
        # PAPER_320
        f_max  = results[27]['f_density_N_m3']
        f_min  = results[26]['f_density_N_m3']
        xi_span = f_max / f_min if f_min > 0 else float('inf')
        # PAPER_322 THz ratio
        a_dpm_34 = results[34]['a_DPM_m_s2']
        a_dpm_30 = results[30]['a_DPM_m_s2']
        THz_ratio = a_dpm_34 / a_dpm_30 if a_dpm_30 != 0 else float('inf')
        return {
            'systems':             results,
            'xi_span_P320':        xi_span,
            'V_f_crossover_P321':  self.V_F_CROSSOVER,
            'THz_ratio_34_30_P322':THz_ratio,
            'papers':              ['PAPER_320', 'PAPER_321', 'PAPER_322'],
            'module':              'COMPRESSED_RESONANCE_UQFF34_MODULE.cpp',
            'module_number':       34,
            'session':             92,
        }


class CompressedResonanceUQFF34bMultiSystemCalculator:
    """Session 93 � CR34b UQFF 2.0 (35th C++ module, CR34 variant, 11-term dual-channel).
    Systems: 18=Sombrero M104, 19=Andromeda M31, 20=Universe, 22=Saturn, 23=M16 Eagle, 24=Crab.
    Adds 11th term: a_aether_freq=F_AETHER*E_VAC_neb*a_DPM/(E_VAC_ISM*c)=5.253e-43*a_DPM.
    Rho-weighted fluid: a_fluid_rho=f_fluid*E_VAC_neb*V*rho*a_DPM/(E_VAC_ISM*c) [PAPER_325].
    PAPER_323: F_AETHER=1.576e-35, PAPER_324: Saturn first planetary, PAPER_325: rho-ISM."""

    E_VAC_NEB = _RHO_VAC_UA
    E_VAC_ISM = _RHO_VAC_SCM
    E_0       = 6.381e-36
    HBAR      = 1.0546e-34
    C_LIGHT   = 3.0e8
    F_AETHER  = 1.576e-35
    LAMBDA    = 1.1e-52

    SYSTEMS = {
        18: {'name': 'Sombrero M104',  'I': 1e22,  'A': 7.487e42, 'omega': 2e-3, 'f_DPM': 1e10, 'V': 4.434e62, 'f_super': 1.411e14, 'rho': 1e-21},
        19: {'name': 'Andromeda M31',  'I': 1e23,  'A': 3.142e42, 'omega': 2e-3, 'f_DPM': 1e10, 'V': 1.543e64, 'f_super': 1.411e14, 'rho': 1e-21},
        20: {'name': 'Universe',       'I': 1e24,  'A': 3.142e52, 'omega': 2e-3, 'f_DPM': 1e9,  'V': 3.568e80, 'f_super': 1.411e13, 'rho': 8.6e-27},
        22: {'name': 'Saturn',         'I': 1e19,  'A': 3.142e15, 'omega': 2e-3, 'f_DPM': 1e12, 'V': 9.184e23, 'f_super': 1.411e16, 'rho': 1e-21},
        23: {'name': 'M16 Eagle',      'I': 1e20,  'A': 3.142e35, 'omega': 2e-3, 'f_DPM': 1e11, 'V': 5.913e53, 'f_super': 1.411e15, 'rho': 1e-20},
        24: {'name': 'Crab Nebula M1', 'I': 1e21,  'A': 3.142e32, 'omega': 2e-3, 'f_DPM': 1e12, 'V': 5.913e50, 'f_super': 1.411e16, 'rho': 1e-21},
    }

    def compute(self, dataset: dict = None) -> dict:
        results = {}
        kappa_af = self.F_AETHER * self.E_VAC_NEB / (self.E_VAC_ISM * self.C_LIGHT)
        xi_fluid  = 1.269e-14 * 1e-21  # f_fluid * rho_ISM [PAPER_325]
        for sid, s in self.SYSTEMS.items():
            F = s['I'] * s['A'] * s['omega']
            a_DPM      = F * s['f_DPM'] * self.E_VAC_NEB / (self.C_LIGHT * s['V'])
            a_vac_diff = self.E_0 * 0.143 * s['V'] * a_DPM / self.HBAR
            A_sc       = self.HBAR * s['f_super'] * s['f_DPM'] / (self.E_VAC_NEB * self.C_LIGHT)
            a_super    = A_sc * a_DPM
            a_af       = kappa_af * a_DPM  # 11th term [PAPER_323]
            a_fl_rho   = 1.269e-14 * self.E_VAC_NEB * 1e3 * s['rho'] * a_DPM / (self.E_VAC_ISM * self.C_LIGHT)
            results[sid] = {
                'name': s['name'], 'a_DPM': a_DPM,
                'a_vac_diff': a_vac_diff, 'a_super': a_super,
                'a_aether_freq_P323': a_af,
                'a_fluid_rho_P325': a_fl_rho,
                'rho_fluid': s['rho'],
            }
        return {
            'systems':              results,
            'F_AETHER_P323':        self.F_AETHER,
            'kappa_aether_freq':    kappa_af,
            'Saturn_first_planet':  True,
            'xi_fluid_ISM_P325':    xi_fluid,
            'papers':               ['PAPER_323', 'PAPER_324', 'PAPER_325'],
            'module':               'COMPRESSED_RESONANCE_UQFF34b_MODULE.cpp',
            'module_number':        '34b',
            'session':              93,
        }


class GrokThread31b5c807TriadicSystemsCalculator:
    """Session 94 � gok_share_31b5c807a4 triadic UQFF systems catalogue.
    Covers: Triadic master FU_g1/R_t/FU_Bi system survey spanning PSZ2,
    AT2024tvd, G359 filament, ASASSN-14li TDE, R Aquarii.
    Q_wave_47 mean=3.97e4 std=6.33e4 J/m^3 (non-Gaussian SW=0.644).
    Nuclear alpha-BEC: T_BEC=14.52 MeV, N_B~29.8, delta_pair=0.1.
    FIRST CP2 triadic/Q_wave47/alpha-BEC integrated session calculator."""
    def __init__(self):
        self.systems = {
            'PSZ2_G181':    {'F_U_Bi': 4.12e-41, 'scale': 'cluster_relic'},
            'AT2024tvd':    {'R_t': -1.12e-42,   'r': 2.47e17, 'scale': 'TDE_offset'},
            'G359_filament':{'R_t': -2.29e-41,   'B0': 1e-5,   'scale': 'GC_filament'},
            'ASASSN_14li':  {'F_U_Bi': 8.32e-211,'scale': 'TDE_compact'},
            'R_Aquarii':    {'F_U_Bi': 2.09e-212,'scale': 'symbiotic_binary'},
        }
        self.Q_wave_mean  = 3.97e4
        self.Q_wave_std   = 6.33e4
        self.SW_stat      = 0.6444
        self.T_BEC_MeV    = 14.52
        self.N_B          = 29.76
        self.delta_pair   = 0.1
        self.sigma_CS_300 = 10.50

    def calculate(self):
        return {
            'triadic_systems':    self.systems,
            'Q_wave_mean_Jm3':    self.Q_wave_mean,
            'Q_wave_std_Jm3':     self.Q_wave_std,
            'SW_stat_normality':  self.SW_stat,
            'normality_rejected': True,
            'T_BEC_MeV':          self.T_BEC_MeV,
            'N_B_BEC':            self.N_B,
            'delta_pair':         self.delta_pair,
            'sigma_CS_300_A2':    self.sigma_CS_300,
            'source':             'gok_share_31b5c807a4',
            'papers':             ['PAPER_326', 'PAPER_327', 'PAPER_328'],
            'session':            94,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
