class NGC1792StarburstFUBiCalculator:
    """Full UQFF FU-Bi pipeline for NGC 1792 starburst galaxy.

    Integrates PAPER_267 sSFR coupling, PAPER_268 Hubble slow mode, and
    PAPER_269 RPDP kinematic invariant into a unified FU/Bi calculation.
    M = 1e10 M_sun, r = 80,000 ly = 7.569e20 m, SFR_factor = 1e-9 yr^-1.
    omega_0 = 1e-12 rad/s (diffuse starburst ISM), sigma_n = 1e-5.
    """

    def __init__(self):
        self.G = 6.674e-11
        self.c = 2.998e8
        self.M0 = 1.989e40          # kg (1e10 Msun)
        self.r = 7.569e20           # m (80,000 ly)
        self.SFR_Msun = 10.0        # M_sun/yr
        self.M0_Msun = 1e10         # M_sun
        self.tau_SF = 100e6 * 3.15576e7   # s (100 Myr)
        self.beta_i = 0.6
        self.omega_g = 7.3e-16     # rad/s
        self.U_UA = 1e-11
        self.M_Fornax = 1.393e44   # kg
        self.r_Fornax = 6.17e23    # m
        self.omega_0 = 1e-12       # rad/s � diffuse starburst ISM
        self.sigma_n = 1e-5        # magnetic coupling
        self.B0 = 1e-5             # T
        self.rho_wind = 1e-21      # kg/m^3
        self.v_wind = 2e6          # m/s
        self.rho_fluid = 1e-21     # kg/m^3
        self.t_Hubble = 4.352e17   # s

    def calculate(self, dataset: dict = None) -> dict:
        import math
        d = dataset or {}
        M0 = d.get('M0', self.M0)
        r = d.get('r', self.r)
        t = d.get('t', 50e6 * 3.15576e7)
        SFR_Msun = d.get('SFR_Msun', self.SFR_Msun)
        M0_Msun = d.get('M0_Msun', self.M0_Msun)
        tau_SF = d.get('tau_SF', self.tau_SF)
        beta_i = d.get('beta_i', self.beta_i)
        omega_g = d.get('omega_g', self.omega_g)
        U_UA = d.get('U_UA', self.U_UA)
        M_ext = d.get('M_Fornax', self.M_Fornax)
        r_ext = d.get('r_Fornax', self.r_Fornax)
        omega_0 = d.get('omega_0', self.omega_0)
        sigma_n = d.get('sigma_n', self.sigma_n)
        B0 = d.get('B0', self.B0)
        rho_wind = d.get('rho_wind', self.rho_wind)
        v_wind = d.get('v_wind', self.v_wind)
        rho_fluid = d.get('rho_fluid', self.rho_fluid)
        t_Hubble = d.get('t_Hubble', self.t_Hubble)

        # Mass growth
        Mt = M0 * (1.0 + SFR_Msun / M0_Msun * t / 3.15576e7)
        ug1_t = dpm_ug1_seed(Mt, r)

        # PAPER_267: sSFR coupling
        sSFR = SFR_Msun / M0_Msun
        decay = math.exp(-t / tau_SF)
        tier1 = 0.5 * ug1_t
        tier2 = abs(beta_i * ug1_t * omega_g * (Mt / r) * U_UA * math.cos(math.pi * t))
        tier3 = abs(beta_i * ug1_t * omega_g * (M_ext / r_ext) * U_UA * math.cos(math.pi * t))
        sSFR_coupling = sSFR * (tier1 + tier2 + tier3) * decay

        # PAPER_268: Hubble slow mode
        omega_fast = 2 * math.pi * self.c / r
        omega_hubble = 2 * math.pi / t_Hubble
        modulation_depth = omega_hubble / omega_fast

        # PAPER_269: RPDP kinematic invariant
        is_rpdp = abs(rho_wind - rho_fluid) == 0.0
        g_feedback = rho_wind * v_wind**2 / rho_fluid if rho_fluid != 0 else 0.0
        kinematic_invariant = v_wind**2

        # FU (unified field)
        FU = ug1_t + omega_0 * sigma_n * B0 * sSFR

        # Bi (buoyancy integral)
        Bi = tier1 + tier2 + tier3

        # Total starburst-corrected gravity
        g_total = FU + Bi * modulation_depth + g_feedback * modulation_depth

        return {
            # Core UQFF
            'FU': FU,
            'Bi': Bi,
            'g_total': g_total,
            # PAPER_267
            'sSFR_coupling': sSFR,
            'sSFR_buoyancy_coherence': sSFR_coupling,
            'tier1_Ubi': tier1,
            'tier2_FUBii': tier2,
            'tier3_Ub_i': tier3,
            # PAPER_268
            'omega_fast_rad_s': omega_fast,
            'omega_hubble_rad_s': omega_hubble,
            'modulation_depth': modulation_depth,
            'modulation_depth_ppm': modulation_depth * 1e6,
            # PAPER_269
            'is_rpdp': is_rpdp,
            'g_feedback_m_s2': g_feedback,
            'kinematic_invariant_v2': kinematic_invariant,
            'rpdp_dominance_ratio': g_feedback / (dpm_ug1_seed(M0, r)) if (dpm_ug1_seed(M0, r)) != 0 else 0,
            # Metadata
            'papers': ['PAPER_267', 'PAPER_268', 'PAPER_269'],
            'system': 'NGC 1792',
            'session': 73,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



