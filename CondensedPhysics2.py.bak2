        D = math.log(visited) / math.log(radius + 1.0)
        return {
            'primary_equations': [
                f'D(c,r) = log({visited:.1f}) / log({radius:.1f}+1) = {D:.4f}',
                'D~3 (flat spacetime), D<3 (fractal/void), D>3 (hyperbolic)',
