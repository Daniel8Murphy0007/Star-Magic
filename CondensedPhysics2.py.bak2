    """PAPER_507: BFS Hausdorff-like dimension estimator for hypergraph spacetime."""

    def compute(self, dataset: dict) -> dict:
        visited = float(dataset.get('visited_count', 8.0))
        radius  = float(dataset.get('radius', 2.0))
        if visited < 1.0:
            visited = 1.0
        if radius < 1e-12:
            return {
                'primary_equations': ['D undefined: radius must be > 0'],
                'available_equations': [],
                'simulation_set': [],
