class UQFFHawkingTemperatureModulationCalculator:
    """
    CP4 #267 � PAPER_683 | UQFF Hawking T modulation � T_UQFF, modulation factor, Wien peak, Planck spectrum shift
    CPP_MODULE: UQFFHawkingTemperatureModulation
    """
    ENTRY   = 267
    PAPER   = "PAPER_683"
    CPP_MODULE = "UQFFHawkingTemperatureModulation"
    UQFF_CONSTANTS = {
        "RHO_UA":  _RHO_VAC_UA,
