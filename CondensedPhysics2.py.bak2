# Red dwarf core analog: densities 10�4-10�6 kg/m�
# H2 vibrational transitions: 10�-104 s?�

ORB_ANALYSIS_33_PARAMS = {
    'directive': 'UFE ORB EXP 2_23_07Mar2025',
    'batch_38_frames': (426, 450),
