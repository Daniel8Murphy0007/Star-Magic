import math as _math_cp2_632

class WaterReactorH2O2Calculator:
    """
    CP2 Entry #632 � Session 168/170
    Water reactor electrolysis H2/O2 energy surplus calculator.
    Models gas production rates, latent heat surplus, and efficiency
    within the UQFF Red Dwarf Reactor experimental framework.

    Key equations:
      h2_mol_rate  = avg_h2_rate  / 22.4 / 60        (mol/s, STP)
      o2_mol_rate  = avg_o2_rate  / 22.4 / 60        (mol/s, STP)
      gas_energy   = h2_mol_rate * 286000 * runtime  (J, HHV hydrogen)
      surplus_mass = total_mass - expected_mass       (kg)
      surplus_energy = surplus_mass * 2257            (J, latent heat H2O)
      efficiency   = (gas_energy + surplus_energy) / (power * runtime)

    Source: SystemAnalysisSimulator_v5/v6 from grok_share_b2e2c5cba7a.txt
    """

    HHV_HYDROGEN_J_PER_MOL = 286000.0   # J/mol (higher heating value)
    LATENT_HEAT_WATER       = 2257.0     # J/g
    MOLAR_VOLUME_STP        = 22.4       # L/mol at STP

    def compute(self, dataset: dict) -> dict:
        avg_h2_rate = dataset.get("avg_h2_rate_L_per_min", 1.0)   # L/min
        avg_o2_rate = dataset.get("avg_o2_rate_L_per_min", 0.5)   # L/min
        power_w     = dataset.get("power_W",        100.0)
        runtime_s   = dataset.get("runtime_s",     3600.0)
        total_mass  = dataset.get("total_mass_g",     0.0)
        exp_mass    = dataset.get("expected_mass_g",  0.0)

        h2_mol_rate    = avg_h2_rate  / self.MOLAR_VOLUME_STP / 60.0
        o2_mol_rate    = avg_o2_rate  / self.MOLAR_VOLUME_STP / 60.0
        gas_energy     = h2_mol_rate  * self.HHV_HYDROGEN_J_PER_MOL * runtime_s
        surplus_mass   = total_mass   - exp_mass
        surplus_energy = surplus_mass * self.LATENT_HEAT_WATER
        input_energy   = power_w * runtime_s
        efficiency     = (gas_energy + surplus_energy) / input_energy if input_energy > 0 else 0.0

        return {
            "class":               "#632  WaterReactorH2O2Calculator",
            "h2_mol_rate_mol_s":   h2_mol_rate,
            "o2_mol_rate_mol_s":   o2_mol_rate,
            "gas_energy_J":        gas_energy,
            "surplus_energy_J":    surplus_energy,
            "input_energy_J":      input_energy,
            "efficiency":          efficiency,
            "equations": [
                "h2_mol_rate = avg_h2_rate / 22.4 / 60",
                "gas_energy  = h2_mol_rate * 286000 * runtime",
                "surplus_energy = surplus_mass * 2257",
                "efficiency = (gas_energy + surplus_energy) / (P * t)",
            ],
        }


class LRCCircuitPseudoMonopoleCalculator:
    """
    CP2 Entry #633 � Session 168/170
    LRC circuit resonance and pseudo-magnetic monopole field calculator.
    Models spark energy dynamics, resonance frequency, and B-field
    from pseudo-monopole current in the UQFF reactor context.

    Key equations:
      resonance_freq = 1 / (2*pi*sqrt(L*C))                   (Hz)
      spark_power    = avg_spark_energy * avg_spark_freq       (W)
      current        = sqrt(2 * spark_power / R)               (A)
      B_monopole     = mu_0 * I / (2*pi * 0.61)               (T at 0.61 m)
      B_at_r         = B_monopole * (0.61 / r)                (T, 1/r falloff)

    Source: SystemAnalysisSimulator_v5/v6 from grok_share_b2e2c5cba7a.txt
    """

    MU_0    = 4.0 * _math_cp2_632.pi * 1.0e-7   # H/m
    R_REF   = 0.61                               # m reference radius

    def compute(self, dataset: dict) -> dict:
        L_H          = dataset.get("inductance_H",      1.0e-3)
        C_F          = dataset.get("capacitance_F",     1.0e-6)
        R_ohm        = dataset.get("resistance_ohm",   10.0)
        spark_energy = dataset.get("avg_spark_energy_J", 1.0e-3)
        spark_freq   = dataset.get("avg_spark_freq_Hz",  50.0)
        r_m          = dataset.get("observation_r_m",    1.0)

        resonance_freq = 1.0 / (2.0 * _math_cp2_632.pi * _math_cp2_632.sqrt(L_H * C_F))
        spark_power    = spark_energy * spark_freq
        current        = _math_cp2_632.sqrt(2.0 * spark_power / R_ohm) if R_ohm > 0 else 0.0
        B_monopole     = self.MU_0 * current / (2.0 * _math_cp2_632.pi * self.R_REF)
        B_at_r         = B_monopole * (self.R_REF / r_m) if r_m > 0 else 0.0

        return {
            "class":               "#633  LRCCircuitPseudoMonopoleCalculator",
            "resonance_freq_Hz":   resonance_freq,
            "spark_power_W":       spark_power,
            "current_A":           current,
            "B_monopole_T":        B_monopole,
            "B_at_r_T":            B_at_r,
            "observation_r_m":     r_m,
            "equations": [
                "f_res = 1 / (2*pi*sqrt(L*C))",
                "I = sqrt(2 * P_spark / R)",
                "B_monopole = mu_0 * I / (2*pi * 0.61)",
                "B(r) = B_monopole * (0.61 / r)",
            ],
        }


class GalacticMotionUFTCalculator:
    """
    CP2 Entry #634 � Session 168/170
    Galactic motion simulator using Unified Field Theory (UFT / UQFF).
    Models spiral-arm body dynamics: Ug1/Ug2/spin rate/PI factor
    over a pixel-mapped galactic plane.

    Key equations:
      dist       = sqrt((x-cx)^2 + (y-cy)^2)              pixels
      velocity   = sqrt(dx^2 + dy^2) / 86400              pixels/s
      mass       = Ug1 * (R * pixelToM)^2 / G             kg
      R_Ug2      = sqrt(mass * Ug2 / (4*pi*rho_aether)) / pixelToM   pixels
      spin_rate  = Ug1 / (R_Ug2 * pixelToM * buoyancy)   rad/s
      pi_factor  = pi * R_Ug2^2                           pixels^2

    Source: SystemAnalysisSimulator_v7 from grok_share_b2e2c5cba7a.txt
    """

    G          = 6.6743e-11    # m^3 kg^-1 s^-2
    RHO_AETHER = _RHO_VAC_UA      # J/m^3  Universal Aether density

    def compute(self, dataset: dict) -> dict:
        x          = dataset.get("x_px",         100.0)
        y          = dataset.get("y_px",         100.0)
        cx         = dataset.get("center_x_px",  256.0)
        cy         = dataset.get("center_y_px",  256.0)
        dx         = dataset.get("dx_px",          1.0)
        dy         = dataset.get("dy_px",          0.5)
        Ug1        = dataset.get("Ug1",           1.0e-10)
        Ug2        = dataset.get("Ug2",           1.0e-10)
        buoyancy   = dataset.get("buoyancy",       1.0)
        pixelToM   = dataset.get("pixel_to_m",    1.0e15)   # m/pixel (galactic scale)

        dist_px   = _math_cp2_632.sqrt((x - cx)**2 + (y - cy)**2)
        R_m       = dist_px * pixelToM
        velocity  = _math_cp2_632.sqrt(dx**2 + dy**2) / 86400.0

        mass      = Ug1 * R_m**2 / self.G if self.G > 0 else 0.0
        denom_ug2 = 4.0 * _math_cp2_632.pi * self.RHO_AETHER
        R_Ug2_m   = _math_cp2_632.sqrt(abs(mass * Ug2 / denom_ug2)) if denom_ug2 > 0 else 0.0
        R_Ug2_px  = R_Ug2_m / pixelToM if pixelToM > 0 else 0.0
        spin_rate = Ug1 / (R_Ug2_m * buoyancy) if (R_Ug2_m * buoyancy) > 0 else 0.0
        pi_factor = _math_cp2_632.pi * R_Ug2_px**2

        return {
            "class":            "#634  GalacticMotionUFTCalculator",
            "dist_px":          dist_px,
            "R_m":              R_m,
            "velocity_px_s":    velocity,
            "mass_kg":          mass,
            "R_Ug2_px":         R_Ug2_px,
            "R_Ug2_m":          R_Ug2_m,
            "spin_rate_rad_s":  spin_rate,
            "pi_factor_px2":    pi_factor,
            "aether_density":   self.RHO_AETHER,
            "equations": [
                "dist = sqrt((x-cx)^2 + (y-cy)^2)",
                "velocity = sqrt(dx^2+dy^2) / 86400",
                "mass = Ug1 * R^2 / G",
                "R_Ug2 = sqrt(mass*Ug2 / (4*pi*rho_aether))",
                "spin_rate = Ug1 / (R_Ug2 * buoyancy)",
                "pi_factor = pi * R_Ug2^2",
            ],
        }


