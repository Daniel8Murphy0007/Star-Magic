# Source10CatalogueFUBiCalculator: Full UQFF FU/Bi pipeline for Source10 (Eta Carinae master)
# omega_0 = 1e-12 rad/s, sigma_n = 1e-5; integrates PAPER_270/271/272 unique physics
# ===========================================================================

class Source10CatalogueFUBiCalculator:
    """Full UQFF FU-Bi pipeline for UQFF Source10 Catalogue (Eta Carinae master system).

    Integrates PAPER_270 DPM g_H amplification, PAPER_271 THz Double-Gate star formation,
    and PAPER_272 Gravitational Vacuum Drag (k_vac=G) into a unified FU/Bi calculation.
    Primary system: Eta Carinae (M = 120 Msun = 2.387e32 kg, r = 7,500 ly = 7.11e19 m).
    Tier 3 external body: Sgr A* (M = 7.956e36 kg, r = 2.623e20 m).
    omega_0 = 1e-12 rad/s (Source10 base frequency), sigma_n = 1e-5.
    """

    def __init__(self):
        self.G = 6.674e-11
        self.c = 2.998e8
        self.hbar = 1.0546e-34          # J�s
        self.M_EtaCar = 2.387e32        # kg (120 Msun)
        self.r_EtaCar = 7.11e19         # m (7,500 ly)
        self.M_GC = 7.956e36            # kg (Sgr A*)
        self.r_GC = 2.623e20            # m (~8.5 kpc)
        self.tau_SF = 1e6 * 3.15576e7   # s (1 Myr canonical)
        self.t_Hubble = 4.352e17        # s
        self.beta_i = 0.6
        self.omega_g = 7.3e-16          # rad/s
        self.U_UA = 1e-4
        self.omega_0 = 1e-12            # rad/s � Source10 base
        self.sigma_n = 1e-5             # magnetic coupling
        self.B0 = 1e-4                  # T
        # PAPER_270 DPM
        self.g_H = 1.252e46
        self.mu_B = 9.274e-24           # J/T
        self.Q_bridge_factor = 2.82e-56
        # PAPER_271 THz Double-Gate
        self.k_conduit = 8.99e9
        self.H_abundance = 0.74
        self.omega_thz = 1.2e12         # rad/s
        self.k_thz = 1.38e-23           # J/K
        self.conduit_scale = 1e12
        self.water_state = 1.0
        self.neutron_factor = 1.0
        # PAPER_272 Vacuum Drag
        self.k_vac = 6.674e-11          # = G
        self.delta_rho_vac = 1e-26      # kg/m^3

    def calculate(self, dataset: dict = None) -> dict:
        import math
        d = dataset or {}
        M = d.get('M', self.M_EtaCar)
        r = d.get('r', self.r_EtaCar)
        t = d.get('t', 1e6 * 3.15576e7)
        M_GC = d.get('M_GC', self.M_GC)
        r_GC = d.get('r_GC', self.r_GC)
        tau_SF = d.get('tau_SF', self.tau_SF)
        beta_i = d.get('beta_i', self.beta_i)
        omega_g = d.get('omega_g', self.omega_g)
        U_UA = d.get('U_UA', self.U_UA)
        omega_0 = d.get('omega_0', self.omega_0)
        sigma_n = d.get('sigma_n', self.sigma_n)
        B0 = d.get('B0', self.B0)
        t_Hubble = d.get('t_Hubble', self.t_Hubble)
        g_H = d.get('g_H', self.g_H)
        mu_B = d.get('mu_B', self.mu_B)
        Q_bridge_factor = d.get('Q_bridge_factor', self.Q_bridge_factor)
        k_conduit = d.get('k_conduit', self.k_conduit)
        H_abundance = d.get('H_abundance', self.H_abundance)
        omega_thz = d.get('omega_thz', self.omega_thz)
        k_thz = d.get('k_thz', self.k_thz)
        conduit_scale = d.get('conduit_scale', self.conduit_scale)
        water_state = d.get('water_state', self.water_state)
        neutron_factor = d.get('neutron_factor', self.neutron_factor)
        k_vac = d.get('k_vac', self.k_vac)
        delta_rho_vac = d.get('delta_rho_vac', self.delta_rho_vac)
        v = d.get('v', 1e4)            # m/s default Eta Carinae wind speed proxy

        # DPM-seeded: Newtonian form is emergent, not foundational\n        ug1_t = dpm_ug1_seed(M, r)

        # 3-tier buoyancy (UQFF Source10 canonical)
        tier1 = 0.5 * ug1_t
        tier2 = abs(beta_i * ug1_t * omega_g * (M / r) * U_UA * math.cos(math.pi * t))
        tier3 = abs(beta_i * ug1_t * omega_g * (M_GC / r_GC) * U_UA * math.cos(math.pi * t))

        # PAPER_270: DPM g_H resonance amplification
        DPM_resonance = g_H * mu_B * B0 / (self.hbar * omega_0)
        Q_bridge = g_H * Q_bridge_factor
        E_DPM = DPM_resonance * Q_bridge_factor
        amplification_decades = math.log10(abs(DPM_resonance)) if DPM_resonance > 0 else 0.0

        # PAPER_271: THz Double-Gate conduit
        F_conduit_norm = k_conduit * H_abundance * water_state * neutron_factor
        thz_ratio_sq = (omega_thz / omega_0) ** 2
        F_thz_shock = k_thz * thz_ratio_sq * neutron_factor * conduit_scale
        both_gates_open = (water_state >= 1.0) and (neutron_factor >= 1.0)

        # PAPER_272: Gravitational vacuum drag
        F_vac_rep = k_vac * delta_rho_vac * M * v
        k_vac_is_G = abs(k_vac - self.G) / self.G < 1e-6

        # FU (unified field) integrating all Source10 papers
        FU = ug1_t + omega_0 * sigma_n * B0 + E_DPM * 1e-200 + F_conduit_norm * 1e-10

        # Bi (buoyancy integral)
        Bi = tier1 + tier2 + tier3

        # Total g
        g_total = FU + Bi + F_vac_rep * 1e-30

        return {
            # Core UQFF
            'FU': FU,
            'Bi': Bi,
            'g_total': g_total,
            'ug1_EtaCar': ug1_t,
            'tier1_Ubi': tier1,
            'tier2_FUBii': tier2,
            'tier3_Ub_i': tier3,
            # PAPER_270
            'DPM_resonance_ratio': DPM_resonance,
            'Q_bridge': Q_bridge,
            'E_DPM_J_per_m3': E_DPM,
            'amplification_decades': amplification_decades,
            # PAPER_271
            'F_conduit_norm': F_conduit_norm,
            'thz_ratio_squared': thz_ratio_sq,
            'F_thz_shock': F_thz_shock,
            'both_gates_open': both_gates_open,
            # PAPER_272
            'F_vac_rep_N': F_vac_rep,
            'k_vac_equals_G': k_vac_is_G,
            'drag_coeff': k_vac * delta_rho_vac,
            # Metadata
            'papers': ['PAPER_270', 'PAPER_271', 'PAPER_272'],
            'system': 'Eta Carinae (Source10 Catalogue Master)',
            'session': 74,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



# ===========================================================================
# AndromedaUQFFGravityCalculator: Full UQFF g_total pipeline for Andromeda (M31)
# M=1e12 Msun, r=1.04e21 m, z=-0.001 (blueshift), f_DM=0.80, nu_HI=1.42040575e9 Hz
# Integrates PAPER_273 kappa_approach, PAPER_274 HI resonance, PAPER_275 DM partition
# ===========================================================================

class AndromedaUQFFGravityCalculator:
    """Full UQFF g_total pipeline for Andromeda Galaxy (M31).

    Integrates PAPER_273 Blueshift Approach Amplifier (kappa_approach=1/(1+z)),
    PAPER_274 HI 21-cm UQFF Galactic Resonance (omega_HI=8.9282e9 rad/s),
    and PAPER_275 DM 80/20 Shell Partition (xi_DM=f_DM^(1/3)=0.9283).
    Primary system: Andromeda M31 (M=1e12 Msun, r=1.04e21 m, z=-0.001, f_DM=0.80).
    """

    def __init__(self):
        import math
        self.G        = 6.674e-11
        self.c        = 2.998e8
        self.hbar     = 1.0546e-34
        self.Lambda   = 1.114e-52
        self.Msun     = 1.989e30
        self.M        = 1.0e12 * self.Msun     # 1.989e42 kg
        self.r        = 1.04e21                 # m
        self.M_BH     = 1.4e8 * self.Msun      # kg
        self.z        = -0.001                  # blueshift
        self.v_orbit  = 2.5e5                   # m/s
        self.B_field  = 5.0e-10                 # T
        self.q_charge = 1.6e-19                 # C
        self.rho_fluid = 1.0e-27               # kg/m�
        self.V_fluid   = 1.0e60               # m�
        self.f_DM     = 0.80
        self.nu_HI    = 1.42040575e9           # Hz
        self.omega_HI = 2.0 * math.pi * self.nu_HI
        self.A_res    = 1.0e-12                # m/s�
        self.tau_gal  = 1.0e9 * 3.15576e7     # s (1 Gyr)
        self.t_Hubble = 4.352e17               # s
        self.delta_x  = 1.0e-10               # m
        self.delta_p  = self.hbar / self.delta_x

    def calculate(self, dataset: dict = None) -> dict:
        import math
        d = dataset or {}
        M        = d.get('M', self.M)
        r        = d.get('r', self.r)
        t        = d.get('t', 0.0)
        z        = d.get('z', self.z)
        f_DM     = d.get('f_DM', self.f_DM)
        nu_HI    = d.get('nu_HI', self.nu_HI)
        A_res    = d.get('A_res', self.A_res)
        tau_gal  = d.get('tau_gal', self.tau_gal)
        v_orbit  = d.get('v_orbit', self.v_orbit)
        B_field  = d.get('B_field', self.B_field)
        rho_fluid = d.get('rho_fluid', self.rho_fluid)
        V_fluid   = d.get('V_fluid', self.V_fluid)

        # kappa_approach (PAPER_273)
        kappa_approach = 1.0 / (1.0 + z)

        # DPM-seeded: Newtonian form is emergent, not foundational\n        g_grav = dpm_ug1_seed(M, r)

        # 26-layer Triadic sum (Ug1 = Ug4 = g_base, Ug2=Ug3=0)
        Ug_sum = 26.0 * 2.0 * g_grav

        # Cosmological term
        Lambda_term = (self.Lambda * self.c ** 2) / 3.0

        # Quantum term
        delta_p = self.hbar / self.delta_x
        quantum = (self.hbar / math.sqrt(self.delta_x * delta_p)) \
                  * 1.0 * (2.0 * math.pi / self.t_Hubble)

        # Lorentz (IGM)
        Lorentz = (self.q_charge * v_orbit * B_field) / M

        # Fluid buoyancy
        rho_mean = M / V_fluid
        fluid    = (rho_fluid / rho_mean) * g_grav

        # HI 21-cm resonance (PAPER_274)
        omega_HI = 2.0 * math.pi * nu_HI
        resonant = A_res * math.cos(omega_HI * t) * math.exp(-t / tau_gal)

        # DM partition (PAPER_275)
        xi_DM  = f_DM ** (1.0 / 3.0)
        g_vis  = self.G * (1.0 - f_DM) * M / (r * r)
        g_dm   = f_DM * dpm_ug1_seed(M, r)
        g_int  = xi_DM * g_vis
        DM_term = g_dm + g_int

        # Friedmann H(z) expansion coupling (PAPER_276)
        H0_kms    = d.get('H0_kms', self.H0)
        Omega_m   = d.get('Omega_m', self.Omega_m)
        Omega_Lam = d.get('Omega_Lam', self.Omega_Lam)
        Mpc_to_m  = d.get('Mpc_to_m', self.Mpc_to_m)
        H_kms  = H0_kms * math.sqrt(Omega_m * (1.0 + z) ** 3 + Omega_Lam)
        H_si   = H_kms * 1.0e3 / Mpc_to_m
        H_UQFF = H_si * self.t_Hubble
        g_expansion = g_grav * H_si * t
        # ISM dust drag (PAPER_276 minor)
        rho_dust = d.get('rho_dust', self.rho_dust)
        a_dust   = (rho_dust * v_orbit ** 2) / (self.c ** 2 * rho_mean) * g_grav
        # M split cascade (PAPER_276)
        M_visible = (1.0 - f_DM) * M
        M_DM_mass = f_DM * M

        g_sum   = g_grav + Ug_sum + Lambda_term + quantum \
                  + Lorentz + fluid + resonant + DM_term \
                  + g_expansion + a_dust
        g_total = g_sum * kappa_approach

        return {
            'g_total_m_s2': g_total,
            'g_grav': g_grav,
            'Ug_sum_26layer': Ug_sum,
            'Lambda_term': Lambda_term,
            'quantum_term': quantum,
            'Lorentz_term': Lorentz,
            'fluid_term': fluid,
            'resonant_HI_term': resonant,
            'DM_total_term': DM_term,
            'kappa_approach': kappa_approach,
            'xi_DM': xi_DM,
            'omega_HI_rad_s': omega_HI,
            'z': z,
            'f_DM': f_DM,
            'g_expansion_m_s2': g_expansion,
            'H_si_s': H_si,
            'H_UQFF': H_UQFF,
            'a_dust_m_s2': a_dust,
            'M_visible_kg': M_visible,
            'M_DM_mass_kg': M_DM_mass,
            'papers': ['PAPER_273', 'PAPER_274', 'PAPER_275', 'PAPER_276'],
            'system': 'Andromeda M31',
            'session': 76,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



# SombreroUQFFGravityCalculator: Full UQFF g_total pipeline for Sombrero Galaxy (M104)
# M=1e11 Msun, r=2.36e20 m, M_BH=1e9 Msun, z=+0.0063 (recession), f_DM=0.80
# Integrates PAPER_277 kappa_recession, PAPER_278 dust ring resonator, PAPER_279 SMBH dominance
# Dual outer multipliers unique to Sombrero: kappa_recession � corr_SC
# ===========================================================================

class SombreroUQFFGravityCalculator:
    """Full UQFF g_total pipeline for Sombrero Galaxy (M104).

    Integrates PAPER_277 Recession Damping (kappa_recession=1/(1+z)=0.99374 for z=+0.0063),
    PAPER_278 Dust Ring UQFF Ring Resonator (F_ring=A_ring*cos(omega_ring*t), omega_ring=1.650e-14 rad/s),
    and PAPER_279 SMBH Dominance Ratio (gamma_BH=0.01, r_SOI=2.36e19 m).
    Unique feature: dual outer multipliers kappa_recession x corr_SC (first in UQFF catalogue).
    Primary system: Sombrero M104 (M=1e11 Msun, r=2.36e20 m, z=+0.0063, M_BH=1e9 Msun).
    """

    def __init__(self):
        import math
        self.G        = 6.674e-11
        self.c        = 2.998e8
        self.hbar     = 1.0546e-34
        self.Lambda   = 1.114e-52
        self.Msun     = 1.989e30
        self.M        = 1.0e11 * self.Msun      # 1.989e41 kg
        self.r        = 2.36e20                  # m
        self.M_BH     = 1.0e9 * self.Msun       # 1.989e39 kg (massive SMBH)
        self.z        = 0.0063                   # recession (positive)
        self.v_orbit  = 2.0e5                    # m/s outer disk
        self.B_field  = 1.0e-9                   # T galactic diffuse (~1 nT)
        self.B_crit   = 1.0e11                   # T magnetar critical (10^15 G)
        self.q_charge = 1.6e-19                  # C proton
        self.rho_fluid = 5.0e-26                # kg/m� ISM
        self.V_fluid  = 1.0e59                   # m� galaxy volume
        self.rho_dust = 5.0e-21                  # kg/m� prominent dust ring
        self.f_DM     = 0.80
        self.f_ring   = 0.001                    # dust ring mass fraction
        self.t_Hubble = 4.352e17                 # s
        self.delta_x  = 1.0e-10                  # m
        self.delta_p  = self.hbar / self.delta_x
        # Friedmann parameters for z>0
        self.H0       = 70.0                     # km/s/Mpc
        self.Omega_m  = 0.3
        self.Omega_Lam = 0.7
        self.Mpc_to_m = 3.086e22

    def calculate(self, dataset: dict = None) -> dict:
        import math
        d = dataset or {}
        M        = d.get('M', self.M)
        r        = d.get('r', self.r)
        t        = d.get('t', 0.0)
        z        = d.get('z', self.z)
        M_BH     = d.get('M_BH', self.M_BH)
        f_DM     = d.get('f_DM', self.f_DM)
        f_ring   = d.get('f_ring', self.f_ring)
        v_orbit  = d.get('v_orbit', self.v_orbit)
        B_field  = d.get('B_field', self.B_field)
        B_crit   = d.get('B_crit', self.B_crit)
        rho_fluid = d.get('rho_fluid', self.rho_fluid)
        rho_dust = d.get('rho_dust', self.rho_dust)
        V_fluid  = d.get('V_fluid', self.V_fluid)
        H0_kms   = d.get('H0_kms', self.H0)
        Omega_m  = d.get('Omega_m', self.Omega_m)
        Omega_Lam = d.get('Omega_Lam', self.Omega_Lam)
        Mpc_to_m = d.get('Mpc_to_m', self.Mpc_to_m)

        # ---- PAPER_277: recession damping ----
        kappa_recession = 1.0 / (1.0 + z)

        # ---- SC correction (unique Sombrero outer multiplier) ----
        corr_SC = 1.0 - B_field / B_crit        # ~ 1 - 1e-20

        # ---- Base Newtonian ----
        g_base = dpm_ug1_seed(M, r)

        # ---- 26-layer Triadic sum (Ug1=Ug4=g_base, Ug2=Ug3=0) ----
        Ug_sum = 26.0 * 2.0 * g_base

        # ---- Cosmological term ----
        Lambda_term = (self.Lambda * self.c ** 2) / 3.0

        # ---- Quantum term ----
        delta_p = self.hbar / self.delta_x
        quantum = (self.hbar / math.sqrt(self.delta_x * delta_p)) \
                  * 1.0 * (2.0 * math.pi / self.t_Hubble)

        # ---- Lorentz ----
        Lorentz = (self.q_charge * v_orbit * B_field) / M

        # ---- Fluid buoyancy ----
        rho_mean = M / V_fluid
        fluid    = (rho_fluid / rho_mean) * g_base

        # ---- PAPER_278: Sombrero Dust Ring UQFF Ring Resonator ----
        r_ring    = r / 3.0
        omega_ring = math.sqrt(self.G * M / (r_ring ** 3))
        A_ring    = 9.0 * f_ring * g_base      # proximity factor = (r/r_ring)� = 9
        F_ring    = A_ring * math.cos(omega_ring * t)   # pure oscillatory (stable ring)
        T_ring_Myr = (2.0 * math.pi / omega_ring) / 3.1557e13

        # ---- PAPER_279: SMBH dominance ----
        gamma_BH = M_BH / M
        g_BH     = dpm_ug1_seed(M_BH, r)     # = gamma_BH * g_base
        r_SOI    = r * math.sqrt(gamma_BH)

        # ---- Friedmann H(z) expansion coupling (PAPER_276 mechanism) ----
        H_kms    = H0_kms * math.sqrt(Omega_m * (1.0 + z) ** 3 + Omega_Lam)
        H_si     = H_kms * 1.0e3 / Mpc_to_m
        g_exp    = g_base * H_si * t

        # ---- ISM dust drag ----
        a_dust   = (rho_dust * v_orbit ** 2) / (self.c ** 2 * rho_mean) * g_base

        # ---- DM direct gravity (Sa spheroidal halo � no NFW coupling) ----
        DM_term  = f_DM * dpm_ug1_seed(M, r)

        # ---- Full sum ----
        g_sum   = g_base + Ug_sum + Lambda_term + quantum \
                  + Lorentz + fluid + F_ring + g_BH \
                  + g_exp + a_dust + DM_term

        # ---- Dual outer multipliers: PAPER_277 � SC correction ----
        g_total = g_sum * kappa_recession * corr_SC

        return {
            'g_total_m_s2':          g_total,
            'g_base_m_s2':           g_base,
            'Ug_sum_26layer':        Ug_sum,
            'Lambda_term':           Lambda_term,
            'quantum_term':          quantum,
            'Lorentz_term':          Lorentz,
            'fluid_term':            fluid,
            'F_ring_m_s2':           F_ring,
            'g_BH_m_s2':             g_BH,
            'g_expansion_m_s2':      g_exp,
            'a_dust_m_s2':           a_dust,
            'DM_term_m_s2':          DM_term,
            'kappa_recession':       kappa_recession,
            'corr_SC':               corr_SC,
            'gamma_BH':              gamma_BH,
            'r_SOI_m':               r_SOI,
            'omega_ring_rad_s':      omega_ring,
            'A_ring_m_s2':           A_ring,
            'T_ring_Myr':            T_ring_Myr,
            'z':                     z,
            'f_DM':                  f_DM,
            'papers':                ['PAPER_277', 'PAPER_278', 'PAPER_279'],
            'system':                'Sombrero M104',
            'session':               77,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
