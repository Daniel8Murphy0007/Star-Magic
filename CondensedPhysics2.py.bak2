# SaturnUQFFGravityCalculator � Session 78�79, PAPER_280�283
# First planetary-scale UQFF module (all prior = stellar/galactic).
# M=5.683e26 kg, r=6.0268e7 m, r_orbit=1.43e12 m, z=0, v_wind=500 m/s
# g_base = G*M/r� = 10.44 m/s� (14 orders of magnitude above galaxy modules)
# pre_sum_Ug = 52�g_base = 542.9 m/s� � FIRST UQFF module with Ug_sum > 1 m/s�
# No kappa_recession (z=0), no DM (f_DM=0), single outer multiplier corr_SC
# PAPER_280: g_Sun_tidal tau_Sun | PAPER_281: ring tidal | PAPER_282: a_wind
# PAPER_283: g_ST_HE = g_Sun_tidal*(1+H0*t); hubble_tidal_factor(4.5 Gyr)=1.3222
# ===========================================================================

class SaturnUQFFGravityCalculator:
    """Full UQFF g_total pipeline for Saturn (Solar System, z=0, planetary scale).

    PAPER_280: Solar Tidal Perturbation (tau_Sun=6.22e-6; g_Sun_tidal,0=6.49e-5 m/s�).
    PAPER_281: Ring Tidal Resonance (omega_ring_kep=1.481e-4 rad/s; T_ring=11.78 h).
    PAPER_282: Atmospheric Wind Kinetic Pressure (a_wind=2.904e-11 m/s�; eta_wind=1.668e-6).
    PAPER_283: Solar Tidal Hubble Expansion Coupling g_ST_HE = g_Sun_tidal*(1+H0*t);
               hubble_tidal_factor(4.5 Gyr)=1.3222; ?g=2.09e-5 m/s�;
               first UQFF multiplicative Solar-Tidal-Hubble term (planetary-stellar-cosmological).
    First planetary-scale module: g_base=10.44 m/s�; pre_sum_Ug=542.9 m/s� (first >1 m/s� in UQFF).
    z=0 � no kappa_recession. f_DM=0 � no dark matter. Single outer multiplier: corr_SC.
    """

    def __init__(self):
        import math
        self.G        = 6.674e-11
        self.c        = 2.998e8
        self.hbar     = 1.0546e-34
        self.Lambda   = 1.114e-52
        self.Msun     = 1.989e30
        self.M        = 5.683e26             # kg Saturn mass
        self.r        = 6.0268e7             # m Saturn equatorial radius
        self.M_Sun    = 1.989e30             # kg Sun mass (PAPER_280)
        self.r_orbit  = 1.43e12              # m Saturn orbital radius from Sun
        self.v_orbit  = 9.632e3              # m/s Saturn orbital velocity ~9.6 km/s
        self.v_wind   = 500.0                # m/s equatorial atmospheric wind (PAPER_282)
        self.M_ring   = 1.5e19               # kg ring system mass (PAPER_281)
        self.r_ring   = 1.2e8                # m mean ring radius (~2� r_Saturn) (PAPER_281)
        self.B_field  = 5.0e-5               # T Saturn magnetic field (~0.5 Gauss)
        self.B_crit   = 1.0e11               # T magnetar critical (10^15 G)
        self.q_charge = 1.6e-19              # C proton
        self.rho_fluid = 0.7                 # kg/m� Saturn upper atmosphere
        self.V_fluid  = 9.172e23             # m� Saturn volume
        self.t_Hubble = 4.352e17             # s
        self.delta_x  = 1.0e-10              # m
        self.delta_p  = self.hbar / self.delta_x
        self.H0       = 70.0
        self.Omega_m  = 0.3
        self.Omega_Lam = 0.7
        self.Mpc_to_m = 3.086e22

    def calculate(self, dataset: dict = None) -> dict:
        import math
        d = dataset or {}
        M        = d.get('M', self.M)
        r        = d.get('r', self.r)
        t        = d.get('t', 0.0)
        M_Sun    = d.get('M_Sun',   self.M_Sun)
        r_orbit  = d.get('r_orbit', self.r_orbit)
        v_orbit  = d.get('v_orbit', self.v_orbit)
        v_wind   = d.get('v_wind',  self.v_wind)
        M_ring   = d.get('M_ring',  self.M_ring)
        r_ring   = d.get('r_ring',  self.r_ring)
        B_field  = d.get('B_field', self.B_field)
        B_crit   = d.get('B_crit',  self.B_crit)
        rho_fluid = d.get('rho_fluid', self.rho_fluid)
        V_fluid  = d.get('V_fluid', self.V_fluid)

        # ---- SC correction (single outer multiplier; z=0, no kappa_recession) ----
        corr_SC = 1.0 - B_field / B_crit     # ~1 - 5e-16 � 1.0

        # ---- Base Newtonian ----
        g_base = dpm_ug1_seed(M, r)         # = 10.44 m/s� for Saturn defaults

        # ---- 26-layer Triadic sum (Ug1=Ug4=g_base, Ug2=Ug3=0) ----
        Ug_sum = 26.0 * 2.0 * g_base         # = 542.9 m/s� � FIRST UQFF >1 m/s�

        # ---- Cosmological term ----
        Lambda_term = (self.Lambda * self.c ** 2) / 3.0

        # ---- Quantum term ----
        delta_p = self.hbar / self.delta_x
        quantum = (self.hbar / math.sqrt(self.delta_x * delta_p)) \
                  * 1.0 * (2.0 * math.pi / self.t_Hubble)

        # ---- Lorentz (orbital velocity � Saturn B field) ----
        Lorentz = (self.q_charge * v_orbit * B_field) / M

        # ---- Fluid buoyancy (atmospheric) ----
        rho_mean = M / V_fluid
        fluid    = (rho_fluid / rho_mean) * g_base

        # ---- PAPER_281: Ring Tidal Gravity Resonance ----
        omega_ring_kep = math.sqrt(self.G * M / r_ring ** 3)
        g_ring_tidal   = self.G * M_ring * r / r_ring ** 3   # first-order ring tidal
        F_ring         = g_ring_tidal * math.cos(omega_ring_kep * t)
        T_ring_h       = (2.0 * math.pi / omega_ring_kep) / 3600.0   # hours

        # ---- PAPER_280+283: Solar Tidal � Hubble Expansion Coupling ----
        g_Sun_tidal_0 = dpm_ug1_seed(M_Sun, r_orbit)    # static tidal (PAPER_280)
        tau_Sun       = (M_Sun / M) * (r / r_orbit) ** 2
        # PAPER_283: multiplicative Hubble modulation on solar tidal
        t_Solar_age         = 4.5e9 * 3.156e7                    # s: 4.5 Gyr = 1.420e17 s
        hubble_tidal_factor = 1.0 + H_si * t_Solar_age           # = 1.3222 at Solar System age
        g_ST_HE = g_Sun_tidal_0 * (1.0 + H_si * t)              # time-dependent solar tidal

        # ---- Friedmann H(z=0) expansion coupling ----
        H_kms  = self.H0 * math.sqrt(self.Omega_m + self.Omega_Lam)   # z=0
        H_si   = H_kms * 1.0e3 / self.Mpc_to_m
        g_exp  = g_base * H_si * t

        # ---- PAPER_282: Atmospheric Wind Kinetic Pressure Term ----
        eta_wind = v_wind / self.c
        a_wind   = eta_wind ** 2 * g_base

        # ---- No DM (f_DM=0, planetary body) ----

        # ---- Full sum (no kappa_recession: z=0) ----
        g_sum   = g_base + Ug_sum + Lambda_term + quantum \
                  + Lorentz + fluid + F_ring + g_ST_HE \
                  + g_exp + a_wind

        # ---- Single outer multiplier ----
        g_total = g_sum * corr_SC

        return {
            'g_total_m_s2':          g_total,
            'g_base_m_s2':           g_base,
            'Ug_sum_26layer':        Ug_sum,
            'Lambda_term':           Lambda_term,
            'quantum_term':          quantum,
            'Lorentz_term':          Lorentz,
            'fluid_term':            fluid,
            'F_ring_tidal_m_s2':     F_ring,
            'g_Sun_tidal_0_m_s2':    g_Sun_tidal_0,
            'g_ST_HE_m_s2':          g_ST_HE,
            'hubble_tidal_factor':   hubble_tidal_factor,
            'delta_g_ST_HE':         g_Sun_tidal_0 * H_si * t_Solar_age,
            'g_expansion_m_s2':      g_exp,
            'a_wind_m_s2':           a_wind,
            'corr_SC':               corr_SC,
            'tau_Sun':               tau_Sun,
            'omega_ring_kep_rad_s':  omega_ring_kep,
            'g_ring_tidal_m_s2':     g_ring_tidal,
            'T_ring_h':              T_ring_h,
            'eta_wind':              eta_wind,
            'z':                     0,
            'f_DM':                  0,
            'pre_sum_Ug_542_9':      Ug_sum,
            'papers':                ['PAPER_280', 'PAPER_281', 'PAPER_282', 'PAPER_283'],
            'system':                'Saturn (Solar System, planetary scale)',
            'session':               79,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



# ---------------------------------------------------------------------------
# Session 80 � M16 Eagle Nebula UQFF 2.0 (22nd C++ module � FIRST nebular z>0)
# PAPER_284: Phi_dm dual mass co-action product (SFR�Erosion multiplicative)
# PAPER_285: t_half=2.079 Myr; DeltaGMax=4.36e-13 m/s�
# PAPER_286: kappa_neb=6.71e-4; H(z=0.0015)=70.047 km/s/Mpc
# ---------------------------------------------------------------------------

class M16UQFFGravityCalculator:
    """UQFF 2.0 gravity calculator for M16 Eagle Nebula (22nd C++ module).
    FIRST UQFF nebular module with z>0 (z=0.0015, ~5700 ly).
    Full g_total = [g_dyn(t) + Ug_sum(26) + Lambda + quantum + Lorentz + fluid + g_exp] * corr_SC
    PAPER_284: Phi_dm = (1+SFR_rate*t)*(1-E_0*(1-exp(-t/tau))) � multiplicative SFR�erosion coupling
    PAPER_285: t_half = tau*ln2 = 6.561e13 s = 2.079 Myr; DeltaGMax = E_0*g_base = 4.36e-13 m/s�
    PAPER_286: kappa_neb = [H(z=0.0015)-H(0)]/H(0) = 6.71e-4; first UQFF kappa_neb
    """

    def calculate(self, dataset: dict) -> dict:
        import math

        # Constants
        G          = dataset.get('G',          6.674e-11)
        Lambda_cos = dataset.get('Lambda_cos', 1.114e-52)
        c_light    = dataset.get('c_light',    2.998e8)
        hbar       = dataset.get('hbar',       1.0546e-34)
        delta_x    = dataset.get('delta_x',    1.0e-10)
        t_Hubble   = dataset.get('t_Hubble',   4.352e17)
        H0         = dataset.get('H0',         70.0)         # km/s/Mpc
        Omega_m    = dataset.get('Omega_m',    0.3)
        Omega_Lam  = dataset.get('Omega_Lam',  0.7)
        Mpc_to_m   = dataset.get('Mpc_to_m',   3.086e22)
        M_Sun      = dataset.get('M_Sun',      1.989e30)

        # M16 nebula parameters
        M0_Msun    = dataset.get('M0_Msun',    1200.0)        # M_sun
        M          = dataset.get('M',          M0_Msun * M_Sun)  # kg
        M0         = dataset.get('M0',         M)
        r          = dataset.get('r',          3.31e17)       # m (~35 ly half-span)
        z          = dataset.get('z',          0.0015)        # FIRST UQFF nebular z>0
        v_gas      = dataset.get('v_gas',      1.0e5)         # m/s turbulent gas
        q_charge   = dataset.get('q_charge',   1.6e-19)       # C proton reference
        B_field    = dataset.get('B_field',    1.0e-5)        # T nebular ~10 uG
        B_crit     = dataset.get('B_crit',     1.0e11)        # T magnetar critical
        rho_fluid  = dataset.get('rho_fluid',  1.0e-20)       # kg/m� dense pillar

        # PAPER_284+285: SFR / erosion                 
        SFR_Msun_yr = dataset.get('SFR_Msun_yr', 1.0)         # M_sun/yr
        tau_erode  = dataset.get('tau_erode',  9.468e13)      # s (3 Myr)
        E_0        = dataset.get('E_0',        0.3)
        t          = dataset.get('t',          1.578e14)      # s default 5 Myr

        # Derived base
        g_base     = dpm_ug1_seed(M, r)
        V_fluid    = (4.0 / 3.0) * math.pi * r**3

        # 26-layer Triadic (Ug2/Ug3=0 for nebula)
        Ug_sum     = 52.0 * g_base                            # pre_sum_Ug

        # PAPER_284: Dual mass co-action product
        SFR_rate   = SFR_Msun_yr / M0_Msun / 3.156e7         # s^-1 = 2.639e-11
        M_sf_frac  = SFR_rate * t
        E_rad      = E_0 * (1.0 - math.exp(-t / tau_erode))
        Phi_dm     = (1.0 + M_sf_frac) * (1.0 - E_rad)
        gap_mult_add = -(M_sf_frac * E_rad)
        g_dyn      = g_base * Phi_dm

        # PAPER_285: Cached diagnostics
        t_half     = tau_erode * math.log(2.0)
        DeltaGMax  = E_0 * g_base

        # Cosmological ? term
        Lambda_tm  = Lambda_cos * c_light**2 / 3.0

        # Quantum HUP term
        delta_p    = hbar / delta_x
        quantum    = (hbar / math.sqrt(delta_x * delta_p)) * (2.0 * math.pi / t_Hubble)

        # Lorentz: turbulent gas � nebular B-field
        Lorentz    = (q_charge * v_gas * B_field) / M

        # Fluid buoyancy (uses g_base, NOT g_dyn � avoids double-counting)
        rho_mean   = M / V_fluid
        fluid      = (rho_fluid / rho_mean) * g_base

        # PAPER_286: Friedmann H(z=0.0015)
        H_z_kms    = H0 * math.sqrt(Omega_m * (1.0 + z)**3 + Omega_Lam)
        H_z_si     = H_z_kms * 1.0e3 / Mpc_to_m
        H_z0_kms   = H0 * math.sqrt(Omega_m + Omega_Lam)
        kappa_neb  = (H_z_kms - H_z0_kms) / H_z0_kms
        g_exp      = g_base * H_z_si * t                     # Friedmann expansion coupling

        # SC correction (near-unity for nebula)
        corr_SC    = 1.0 - B_field / B_crit

        # Full g_total
        g_sum      = g_dyn + Ug_sum + Lambda_tm + quantum + Lorentz + fluid + g_exp
        g_total    = g_sum * corr_SC

        return {
            'g_total_m_s2':      g_total,
            'g_base_m_s2':       g_base,
            'g_dyn_m_s2':        g_dyn,
            'Phi_dm':            Phi_dm,
            'M_sf_frac':         M_sf_frac,
            'E_rad':             E_rad,
            'gap_mult_add':      gap_mult_add,
            'SFR_rate_per_s':    SFR_rate,
            'Ug_sum_m_s2':       Ug_sum,
            'Lambda_term_m_s2':  Lambda_tm,
            'quantum_term_m_s2': quantum,
            'Lorentz_m_s2':      Lorentz,
            'fluid_m_s2':        fluid,
            'g_exp_m_s2':        g_exp,
            'H_z_km_s_Mpc':      H_z_kms,
            'kappa_neb':         kappa_neb,
            't_half_s':          t_half,
            't_half_Myr':        2.079,
            'DeltaGMax_m_s2':    DeltaGMax,
            'corr_SC':           corr_SC,
            'V_fluid_m3':        V_fluid,
            'z':                 z,
            'f_DM':              0.0,
            'pre_sum_Ug_7_56e11': Ug_sum,
            'papers':            ['PAPER_284', 'PAPER_285', 'PAPER_286'],
            'system':            'M16 Eagle Nebula (IC 4703) � first UQFF nebular z>0',
            'session':           80,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
