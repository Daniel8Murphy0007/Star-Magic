class DPMFullFormulationCalculator:
    """
    PAPER_496 � Di-Pseudo-Monopole (DPM) Full UQFF Formulation.

    DPM_ref = kappa * (DPMn(SCm) - DPMs(UA')) / r^26
            + d^26(DPMn + DPMs) / dt^26
            + Grind_opp

    Grind_opp = omega_CW * SCm - omega_CCW * UA'

    DPM is canonical to ALL force triad generation (Ug, Um, Ub).
    North pole: SCm (massless, CW). South pole: UA' (trapped Aether, CCW).
    Dictates ALL downstream physics � solve DPM first.

    Source: grok_share_1jkdsgv7.txt (Session 134, March 24 2026).
    """
    KAPPA_DEFAULT = 5e-4  # /day, UQFF calibration

    def compute(self, dataset: dict) -> dict:
        kappa      = dataset.get('kappa',      self.KAPPA_DEFAULT)
        DPMn       = dataset.get('DPMn_SCm',   1.0)
        DPMs       = dataset.get('DPMs_UAp',   0.5)
        r26        = dataset.get('r26',         1e-35)
        omega_CW   = dataset.get('omega_CW',   1.0)
        omega_CCW  = dataset.get('omega_CCW',  1.0)
        SCm_val    = dataset.get('SCm',         0.99)
        UA_prime   = dataset.get('UA_prime',   0.5)
        t          = dataset.get('t',           0.0)

        if r26 == 0 or abs(r26) < 1e-12:
            r26 = 1e-12  # Prevent r26**26 underflow to 0.0 (10^-910 < float min)

        grad_term  = kappa * (DPMn - DPMs) / (r26 ** 26)
        time_term  = kappa * (DPMn + DPMs) * _math.exp(-abs(t) / 1e26)
        grind_opp  = omega_CW * SCm_val - omega_CCW * UA_prime
        DPM_ref    = grad_term + time_term + grind_opp

        return {
            'primary_equations': {
                'DPM_ref':    DPM_ref,
                'grad_term':  grad_term,
                'time_term':  time_term,
                'grind_opp':  grind_opp,
            },
            'available_equations': [
                f'DPM_ref = kappa*(DPMn-DPMs)/r^26 + d^26(DPMn+DPMs)/dt^26 + Grind_opp = {DPM_ref:.6e}',
                f'Grind_opp = omega_CW*SCm - omega_CCW*UA\' = {grind_opp:.6e}',
                f'Gradient term = {grad_term:.6e}',
                f'Time-reversal term = {time_term:.6e}',
                'Force triad: F_U = DPM_ref * (Ug + Um + Ub)',
                'North pole: SCm (massless, CW) | South pole: UA\' (trapped Aether, CCW)',
                f'kappa={kappa:.2e}/day | r26={r26:.2e} | 26D radial distance',
            ],
            'simulation_set': [
                {'label': 'Big Bang contact',  'DPMn_SCm': 1.0, 'DPMs_UAp': 0.0, 't': 0.0},
                {'label': 'Grinding steady',   'DPMn_SCm': 1.0, 'DPMs_UAp': 0.5, 't': 1e10},
                {'label': 'Magnetar scale',    'DPMn_SCm': 10.0, 'DPMs_UAp': 5.0, 'r26': 1e-40},
            ],
        }


class TwentySixDProjectionCalculator:
    """
    PAPER_497 � 26D Downward Projection: Energy Falls to Yield Mass.

    M = E^26D / c^26 * (1 - v_current/v_init) * Prob_order

    Universe = one 26D cosmic egg expanding to catch Big Bang speed.
    26D -> 9D -> 3D -> 2D projection ONLY (downward).
    2D is reference plane only � NOT a foundation.
    Solid ground is the RESULT, not the starting point.
    Vacuum standards arise from incomplete speed recovery.

    Source: grok_share_1jkdsgv7.txt (Session 134, March 24 2026).
    """

    def compute(self, dataset: dict) -> dict:
        E_26D      = dataset.get('E_26D',      1e30)    # J
        c_26D      = dataset.get('c_26D',      3e8)     # effective 26D lightspeed
        v_current  = dataset.get('v_current',  6.7e4)   # m/s (Hubble expansion)
        v_init     = dataset.get('v_init',     1e15)    # Big Bang initial speed
        Prob_order = dataset.get('Prob_order', 0.57)    # [SSq] default calibration

        if c_26D == 0 or v_init == 0:
            return {'primary_equations': {'M_emerged': 0.0}, 'available_equations': [], 'simulation_set': []}

        speed_ratio = max(1.0 - v_current / v_init, 0.0)
        c26_power   = c_26D ** 26
        M_emerged   = (E_26D / c26_power) * speed_ratio * Prob_order

        vacuum_std  = 1.0 - speed_ratio  # incomplete recovery fraction
        expansion_drive = v_init - v_current

        return {
            'primary_equations': {
                'M_emerged':       M_emerged,
                'speed_ratio':     speed_ratio,
                'vacuum_standard': vacuum_std,
                'expansion_drive': expansion_drive,
            },
            'available_equations': [
