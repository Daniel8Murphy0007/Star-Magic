            'P_order': reg['P_order'],
            'U_bjet_harmonic': bh['U_bjet_harmonic'],
            'existence_IVT': reg['existence_IVT'],
            'uniqueness_pi': reg['uniqueness_pi'],
            'equation': 'NS_disc = ?R(u) + ?u�R(u) + R(p) - �R�(u) - U_bjet = 0',
            'key_result': reg['description'],
            'primary_equations': [
