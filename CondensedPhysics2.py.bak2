    CPP_MODULE: UQFFPredictionsForLISA
    """
    ENTRY   = 261
    PAPER   = "PAPER_677"
    CPP_MODULE = "UQFFPredictionsForLISA"
    UQFF_CONSTANTS = {
        "RHO_UA":  _RHO_VAC_UA,
