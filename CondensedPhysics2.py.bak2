        return {
            'regular': reg,
            'lambda_max': eig['lambda_max'],
            'P_order': P,
            'existence_IVT': True,   # IVT guarantees at least one crossing
            'uniqueness_pi': True,    # p transcendental ? non-repeating crossings
            'description': (
                f"NS regularity: {'HOLDS' if reg else 'UNVERIFIED'}. "
                f"?_max = {eig['lambda_max']:.3e} {'<' if reg else '='} 1. "
                f"Existence (3D-IPO IVT): True. Uniqueness (p): True."
            )
        }

    def compute(self, dataset: dict) -> dict:
        eig = self.compute_eigenvalues(dataset)
