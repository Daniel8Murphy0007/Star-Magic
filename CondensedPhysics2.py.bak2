        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



class ResonanceSCUQFFGravityCalculator:
    """UQFF 2.0 gravity calculator for the Resonance-Superconductive universal module (23rd C++ module).
    FIRST UQFF pure resonance-SC module: No fixed astrophysical object � universal vacuum resonance.
    Default context: plasmotic vacuum, magnetar-scale critical field (B_crit=1e11 T).
    g_res_sc = (a_DPM+a_THz+a_aether+a_u_g4i+a_osc+a_sc_freq) * (1-B/B_crit) * (1+f_TRZ)
    PAPER_287: DPM-THz cascade Gamma_THz=3.33e7; a_DPM=3.545e-18 m/s^2; a_THz=1.182e-10 m/s^2
    PAPER_288: a_osc = 2A*cos(kx)*cos(wt) + (2pi/13.8)*A*Re[exp(i*(kx-wt))]; T/S=pi/13.8=0.2277
    PAPER_289: A_sc=6.994e21; E_Cooper=1.488e-18 J; SCm=1-B/B_crit -> Meissner quench at B=B_crit
    """

    def calculate(self, dataset: dict) -> dict:
        import math, cmath

        # Physical constants
        c_light  = dataset.get('c_light',  3.0e8)
        hbar     = dataset.get('hbar',     1.0546e-34)
        E_vac    = dataset.get('E_vac',    _RHO_VAC_UA)     # J/m^3 plasmotic vacuum

        # Resonance parameters (PAPER_287)
        f_DPM    = dataset.get('f_DPM',    1.0e12)
        f_THz    = dataset.get('f_THz',    1.0e12)
        f_aether = dataset.get('f_aether', 1.0e4)
        f_react  = dataset.get('f_react',  1.0e10)
        I_curr   = dataset.get('I_curr',   1.0e21)
        A_vort   = dataset.get('A_vort',   3.142e8)
        omega_1  = dataset.get('omega_1',  1.0e-3)
        omega_2  = dataset.get('omega_2',  -1.0e-3)
        v_exp    = dataset.get('v_exp',    1.0e3)
        V_sys    = dataset.get('V_sys',    4.189e12)
        f_sc     = dataset.get('f_sc',     1.0)

        # Oscillatory (PAPER_288)
        A_amp    = dataset.get('A_amp',    1.0e-10)
        k_wave   = dataset.get('k_wave',   1.0e20)
        omega_osc= dataset.get('omega_osc',1.0e15)
        x_pos    = dataset.get('x_pos',    0.0)
        t        = dataset.get('t',        0.0)
        T_cosmic = 13.8    # Gyr � universe age normalization [PAPER_288]

        # Superconductivity (PAPER_289)
        B_field  = dataset.get('B_field',  1.0e-5)
        B_crit   = dataset.get('B_crit',   1.0e11)
        f_super  = dataset.get('f_super',  1.411e16)
        f_TRZ    = dataset.get('f_TRZ',    0.1)

        # --- PAPER_287: DPM base + THz cascade ---
        F_DPM      = I_curr * A_vort * (omega_1 - omega_2)          # 6.284e26 N
        a_DPM      = (F_DPM * f_DPM * E_vac) / (c_light * V_sys)   # 3.545e-18 m/s^2
        E_vac_ISM  = E_vac / 10.0
        Gamma_THz  = 10.0 * f_THz * v_exp / c_light                 # 3.33e7
        a_THz      = Gamma_THz * a_DPM                              # 1.182e-10 m/s^2
        a_aether   = f_aether * 1.0e-8 * f_DPM * (1.0 + f_TRZ) * a_DPM
        a_u_g4i    = f_sc * f_react * a_DPM / (E_vac * c_light)

        # --- PAPER_288: Cosmic-age standing-traveling wave ---
        a_standing  = 2.0 * A_amp * math.cos(k_wave * x_pos) * math.cos(omega_osc * t)
        phase       = complex(0.0, k_wave * x_pos - omega_osc * t)
        a_traveling = (2.0 * math.pi / T_cosmic) * A_amp * cmath.exp(phase).real
        a_osc       = a_standing + a_traveling
        T_S_ratio   = math.pi / T_cosmic                            # 0.2277

        # --- PAPER_289: Cooper-DPM SC synthesis + Meissner correction ---
        E_Cooper    = hbar * f_super                                # 1.488e-18 J
        A_sc_factor = hbar * f_super * f_DPM / (E_vac * c_light)   # 6.994e21
        a_sc_freq   = A_sc_factor * a_DPM
        SCm         = 1.0 - B_field / B_crit

        # --- Full resonance sum + SC quench ---
        a_res_total = a_DPM + a_THz + a_aether + a_u_g4i + a_osc + a_sc_freq
        g_res_sc    = a_res_total * SCm * (1.0 + f_TRZ)

        return {
            'g_res_sc_m_s2':      g_res_sc,
            'a_DPM_m_s2':         a_DPM,
            'F_DPM_N':            F_DPM,
            'Gamma_THz':          Gamma_THz,
            'a_THz_m_s2':         a_THz,
            'a_aether_m_s2':      a_aether,
            'a_u_g4i_m_s2':       a_u_g4i,
            'a_standing_m':       a_standing,
            'a_traveling_m':      a_traveling,
            'a_osc_m_s2':         a_osc,
            'T_S_ratio':          T_S_ratio,
            'E_Cooper_J':         E_Cooper,
            'A_sc_factor':        A_sc_factor,
            'a_sc_freq_m_s2':     a_sc_freq,
            'a_res_total_m_s2':   a_res_total,
            'SCm':                SCm,
            'B_field_T':          B_field,
            'B_crit_T':           B_crit,
            'f_TRZ':              f_TRZ,
            'papers':             ['PAPER_287', 'PAPER_288', 'PAPER_289'],
            'system':             'Universal RSC UQFF � 23rd C++ module FIRST universal RSC',
            'session':            81,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



class CrabResonanceUQFFGravityCalculator:
    """UQFF 2.0 gravity calculator for the Crab Nebula Resonance module (24th C++ module).
    FIRST UQFF Pulsar Wind Nebula (PWN) module: Crab Nebula M1, SN 1054 CE, ~2 kpc, z�0.
    M=4.6 M_sun=9.149e30 kg; r0=5.2e16 m; v_exp=1.5e6 m/s; f_pulsar=30.2 Hz.
    g_Crab = (a_DPM(t)+a_THz+a_aether+a_u_g4i+a_quantum+a_fluid+a_osc+a_exp)*(1-B/B_crit)*(1+f_TRZ)
    PAPER_290: a_DPM(t)=F_DPM*f_DPM*E_vac/(c*(4/3)*pi*(r0+v_exp*t)^3); D=6.69x dilution; Gamma_THz=5.0e10
    PAPER_291: Filament Spectral Triad f_q=1.445e-17/f_fl=1.269e-14/f_exp=1.373e-8 Hz; V_knot=1e3 m^3
    PAPER_292: f_osc=30.2*60=1812 Hz; omega_p=11385 rad/s; A_pulsar=1.812e-19 m; pulse_lock=1.812e-9
    """

    def calculate(self, dataset: dict) -> dict:
        import math, cmath

        # Physical constants
        c_light  = dataset.get('c_light',  3.0e8)
        hbar     = dataset.get('hbar',     1.0546e-34)
        E_vac    = dataset.get('E_vac',    _RHO_VAC_UA)

        # Crab parameters (PAPER_290)
        r0       = dataset.get('r0',       5.2e16)
        v_exp    = dataset.get('v_exp',    1.5e6)
        t        = dataset.get('t',        0.0)
        f_DPM    = dataset.get('f_DPM',    1.0e12)
        f_THz    = dataset.get('f_THz',    1.0e12)
        f_aether = dataset.get('f_aether', 1.0e4)
        f_react  = dataset.get('f_react',  1.0e10)
        I_curr   = dataset.get('I_curr',   1.0e21)
        A_vort   = dataset.get('A_vort',   3.142e8)
        omega_1  = dataset.get('omega_1',  1.0e-3)
        omega_2  = dataset.get('omega_2',  -1.0e-3)
        f_sc     = dataset.get('f_sc',     1.0)

        # Filament spectral triad (PAPER_291)
        f_quantum = dataset.get('f_quantum', 1.445e-17)
        f_fluid   = dataset.get('f_fluid',   1.269e-14)
        f_exp_fr  = dataset.get('f_exp_freq',1.373e-8)
        V_knot    = dataset.get('V_knot',    1.0e3)

        # Oscillatory + pulsar (PAPER_292)
        A_amp      = dataset.get('A_amp',    1.0e-10)
        k_wave     = dataset.get('k_wave',   1.0e20)
        omega_osc  = dataset.get('omega_osc',1.0e15)
        x_pos      = dataset.get('x_pos',    0.0)
        f_pulsar   = dataset.get('f_pulsar', 30.2)
        T_cosmic   = 13.8

        # SC / TRZ (PAPER_289 pattern)
        B_field  = dataset.get('B_field',  1.0e-8)
        B_crit   = dataset.get('B_crit',   1.0e11)
        f_TRZ    = dataset.get('f_TRZ',    0.1)

        # --- PAPER_290: DPM base with dynamic V_sys(t) ---
        F_DPM     = I_curr * A_vort * (omega_1 - omega_2)        # 6.284e26 N
        r_t       = r0 + v_exp * t
        V_sys_t   = (4.0 / 3.0) * math.pi * r_t ** 3
        a_DPM     = (F_DPM * f_DPM * E_vac) / (c_light * V_sys_t)
        V0        = (4.0 / 3.0) * math.pi * r0 ** 3
        a_DPM_t0  = (F_DPM * f_DPM * E_vac) / (c_light * V0)
        dilution_D = V_sys_t / V0
        Gamma_THz = 10.0 * f_THz * v_exp / c_light               # 5.0e10
        E_vac_ISM = E_vac / 10.0
        a_THz     = Gamma_THz * a_DPM
        a_aether  = f_aether * 1.0e-8 * f_DPM * (1.0 + f_TRZ) * a_DPM
        a_u_g4i   = f_sc * f_react * a_DPM / (E_vac * c_light)

        # --- PAPER_291: filament spectral triad ---
        a_quantum = (f_quantum * E_vac * a_DPM) / (E_vac_ISM * c_light)
        a_fluid   = (f_fluid   * E_vac * V_knot * a_DPM) / (E_vac_ISM * c_light)
        a_exp     = (f_exp_fr  * E_vac * a_DPM) / (E_vac_ISM * c_light)

        # --- PAPER_288 (inherited) + PAPER_292 oscillatory ---
        f_osc      = f_pulsar * 60.0                              # 1812 Hz
        omega_p    = 2.0 * math.pi * f_osc                       # 11385 rad/s
        A_pulsar   = (f_osc / f_DPM) * A_amp                     # 1.812e-19 m
        a_standing = 2.0 * A_amp * math.cos(k_wave * x_pos) * math.cos(omega_osc * t)
        phase      = complex(0.0, k_wave * x_pos - omega_osc * t)
        a_travel   = (2.0 * math.pi / T_cosmic) * A_amp * cmath.exp(phase).real
        a_pulsar_m = A_pulsar * math.cos(omega_p * t)            # PAPER_292
        a_osc      = a_standing + a_travel + a_pulsar_m

        # --- Full 8-term resonance sum + SC quench ---
        res_sum    = a_DPM + a_THz + a_aether + a_u_g4i + a_quantum + a_fluid + a_osc + a_exp
        SCm        = 1.0 - B_field / B_crit
        g_Crab     = res_sum * SCm * (1.0 + f_TRZ)

        return {
            'g_Crab_m_s2':          g_Crab,
            'a_DPM_t0_m_s2':        a_DPM_t0,
            'a_DPM_t_m_s2':         a_DPM,
            'F_DPM_N':              F_DPM,
            'V_sys_t_m3':           V_sys_t,
            'dilution_D':           dilution_D,
            'Gamma_THz':            Gamma_THz,
            'a_THz_m_s2':           a_THz,
            'a_aether_m_s2':        a_aether,
            'a_u_g4i_m_s2':         a_u_g4i,
            'a_quantum_m_s2':       a_quantum,
            'a_fluid_m_s2':         a_fluid,
            'a_exp_m_s2':           a_exp,
            'f_osc_Hz':             f_osc,
            'omega_pulsar_rad_s':   omega_p,
            'A_pulsar_m':           A_pulsar,
            'pulse_lock':           f_osc / f_DPM,
            'a_standing_m_s2':      a_standing,
            'a_traveling_m_s2':     a_travel,
            'a_pulsar_mod_m_s2':    a_pulsar_m,
            'a_osc_m_s2':           a_osc,
            'res_sum_m_s2':         res_sum,
            'SCm':                  SCm,
            'B_field_T':            B_field,
            'B_crit_T':             B_crit,
            'f_TRZ':                f_TRZ,
            'papers':               ['PAPER_290', 'PAPER_291', 'PAPER_292'],
            'system':               'Crab Nebula M1 PWN � UQFF 2.0 24th C++ module',
            'session':              82,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
        t_n = dataset.get('t_n',    0.0)
        kappa   = dataset.get('kappa',   0.0005)
        E_react = dataset.get('E_react', 1.0e46)
        beta_i  = dataset.get('beta_i', 0.6)
        SSq     = dataset.get('SSq',     0.57)
        Omega_g = dataset.get('Omega_g', 7.3e-16)
        M_bh    = dataset.get('M_bh',    8.15e36)
        d_g     = dataset.get('d_g',     2.55e20)
        # --- DPM-seeded gravity family (NOT Newton-first) ---
        g_b = dpm_ug1_seed(M, r, B)  # Ug1: DPM seed
        Ug1 = g_b
        Ug2 = 1.2  * g_b  # charge-reactivity shell
        Ug3 = 0.8  * g_b * math.cos(math.pi * t_n)  # magnetic string rotation
        Ug4 = 0.5  * g_b  # BH vacuum concentration
        # Buoyancy (inside-out counter-force)
        Ub = -beta_i * Ug1 * Omega_g * (M_bh / max(d_g, 1.0)) * (
            1.0 + 0.1 * math.cos(math.pi * t_n)
        )
        # Unified field
        F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub
        # GM/r^2 appears LAST as a derived observational projection only
        _G = 6.6743e-11
        g_projection = _G * M / (r ** 2) if r > 0 else 0.0
        return {
            'primary_equations': [
                f'Ug1(DPM-seed) = dpm_ug1_seed(M,r,B) = {Ug1:.6e}',
                f'Ug2(shell)    = 1.2*Ug1                 = {Ug2:.6e}',
                f'Ug3(string)   = 0.8*Ug1*cos(pi*t_n)    = {Ug3:.6e}',
                f'Ug4(BH-vac)   = 0.5*Ug1                 = {Ug4:.6e}',
                f'Ub (buoyancy) = {Ub:.6e}',
                f'F_U(unified)  = {F_U:.6e}',
                f'GM/r^2(projection, LAST) = {g_projection:.6e} m/s^2',
            ],
            'available_equations': [
                'g_base = dpm_ug1_seed(M, r, B)  # DPM-seeded, not Newton',
                'Ug1 = g_base  # seed from DPM vortex',
                'Ug2 = 1.2 * Ug1  # charge-reactivity',
                'Ug3 = 0.8 * Ug1 * cos(pi*t_n)  # magnetic string 90deg',
                'Ug4 = 0.5 * Ug1  # BH vacuum concentration',
                'Ub = -beta_i * Ug1 * Omega_g * M_bh/d_g  # buoyancy counter',
                'F_U = Ug1 + Ug2 + Ug3 + Ug4 + Ub  # unified field',
                'GM/r^2 = projection of F_U (EMERGENT, appears last)',
            ],
            'simulation_set': [
                {'equation': 'F_U_vs_r',  'M_kg': M, 'r_m': r, 'result': F_U},
                {'equation': 'Ug1_vs_B',  'B_T':  B, 'r_m': r, 'result': Ug1},
            ],
            'Ug1': Ug1, 'Ug2': Ug2, 'Ug3': Ug3, 'Ug4': Ug4,
            'Ub': Ub, 'F_U': F_U, 'g_base': g_b,
            'g_projection_GM_r2': g_projection,
        }



# ===========================================================================
# Session 83 � PAPER_293�295  CR24 UQFF 2.0  (25th C++ module, FIRST dual-channel)
# PAPER_293: Dual-Channel Co-Sum Architecture  R_CR=1.490e-17 (resonance dominates 17 orders)
# PAPER_294: Vacuum Differential Harmonic  a_vac_diff=128.4 m/s�  FIRST UQFF h-denom term
# PAPER_295: Compressed Cooper Super-Seeding  a_super ? f_DPM�  A_sc=6.994e18 sys18-24
# ===========================================================================

class CompressedResonanceUQFF24GravityCalculator:
    """PAPER_293/294/295 � CR24 UQFF 2.0 Dual-Channel Gravity Calculator (Session 83).

    Full 10-term pipeline: Compressed (4) + Resonance (6) co-sum.
    g_CR = (S_comp + S_res) � SCm � (1 + f_TRZ)
    Systems 18-24 class:  f_DPM = 1e11 Hz.
    """

    _C     = 3.0e8
    _HBAR  = 1.0546e-34
    _E_VAC = _RHO_VAC_UA
    _PI    = 3.141592653589793
    _T_COS = 13.8               # Gyr cosmic age normalisation

    def calculate(self, dataset: dict) -> dict:
        f_DPM      = dataset.get('f_DPM',      1.0e11)
        f_THz      = dataset.get('f_THz',      1.0e11)
        f_vac_diff = dataset.get('f_vac_diff', 0.143)
        f_super    = dataset.get('f_super',    1.411e15)
        I_curr     = dataset.get('I',          1.0e20)
        A_vort     = dataset.get('A_vort',     3.142e18)
        omega_1    = dataset.get('omega_1',    1.0e-2)
        omega_2    = dataset.get('omega_2',   -1.0e-2)
        v_exp      = dataset.get('v_exp',      1.0e5)
        E_0        = dataset.get('E_0',        6.381e-36)
        V_sys      = dataset.get('V_sys',      4.189e18)
        f_aether   = dataset.get('f_aether',   1.0e3)
        f_react    = dataset.get('f_react',    1.0e9)
        f_quantum  = dataset.get('f_quantum',  1.445e-17)
        f_fluid    = dataset.get('f_fluid',    1.269e-14)
        f_exp_freq = dataset.get('f_exp_freq', 1.373e-8)
        V_fluid    = dataset.get('V_fluid',    1.0e6)
        omega_osc  = dataset.get('omega_osc',  1.0e14)
        k_wave     = dataset.get('k_wave',     1.0e18)
        A_amp      = dataset.get('A_amp',      1.0e-9)
        t          = dataset.get('t',          0.0)
        B          = dataset.get('B',          0.0)
        B_crit     = dataset.get('B_crit',     1.0e11)
        f_sc       = dataset.get('f_sc',       1.0)
        f_TRZ      = dataset.get('f_TRZ',      0.1)
        E_ISM      = self._E_VAC / 10.0

        # --- DPM force and base acceleration ---
        F_DPM = I_curr * A_vort * (omega_1 - omega_2)
        a_DPM = (F_DPM * f_DPM * self._E_VAC) / (self._C * V_sys)

        # --- Compressed channel (4 terms) ---
        Gamma_THz  = 10.0 * f_THz * v_exp / self._C
        a_THz      = Gamma_THz * a_DPM
        # [PAPER_294] h-denominator vacuum differential harmonic
        a_vac_diff = (E_0 * f_vac_diff * V_sys * a_DPM) / self._HBAR
        # [PAPER_295] Compressed Cooper super-seeding; A_sc ? f_DPM ? a_super ? f_DPM�
        A_sc       = (self._HBAR * f_super * f_DPM) / (self._E_VAC * self._C)
        a_super    = A_sc * a_DPM
        sigma_comp = a_DPM + a_THz + a_vac_diff + a_super

        # --- Resonance channel (6 terms) ---
        a_aether  = f_aether * 1.0e-8 * f_DPM * (1.0 + f_TRZ) * a_DPM
        a_u_g4i   = f_sc * f_react * a_DPM / (self._E_VAC * self._C)
        import math, cmath
        a_standing  = 2.0 * A_amp * math.cos(k_wave * 0.0) * math.cos(omega_osc * t)
        phase       = complex(0.0, k_wave * 0.0 - omega_osc * t)
        a_traveling = (2.0 * self._PI / self._T_COS) * A_amp * cmath.exp(phase).real
        a_osc       = a_standing + a_traveling
        a_quantum = (f_quantum * self._E_VAC * a_DPM) / (E_ISM * self._C)
        a_fluid   = (f_fluid * self._E_VAC * V_fluid * a_DPM) / (E_ISM * self._C)
        a_exp     = (f_exp_freq * self._E_VAC * a_DPM) / (E_ISM * self._C)
        sigma_res = a_aether + a_u_g4i + a_osc + a_quantum + a_fluid + a_exp

        # --- Co-sum + SC + TRZ ---
        SCm  = 1.0 - B / B_crit
        g_CR = (sigma_comp + sigma_res) * SCm * (1.0 + f_TRZ)

        # --- PAPER_293: channel dominance ratio ---
        R_CR = sigma_comp / sigma_res if sigma_res != 0.0 else 0.0

        # --- PAPER_294: VDH derived observables ---
        T_vac          = 1.0 / f_vac_diff
        E_0_over_E_vac = E_0 / self._E_VAC
        V_over_hbar    = V_sys / self._HBAR

        # --- PAPER_295: f_DPM� scaling check at adjacent class ---
        f_DPM_x10   = f_DPM * 10.0
        A_sc_x10    = (self._HBAR * f_super * f_DPM_x10) / (self._E_VAC * self._C)
        a_DPM_x10   = (F_DPM * f_DPM_x10 * self._E_VAC) / (self._C * V_sys)
        a_super_x10 = A_sc_x10 * a_DPM_x10

        return {
            # Pipeline intermediates
            'F_DPM_N':                 F_DPM,
            'a_DPM_m_s2':              a_DPM,
            'Gamma_THz':               Gamma_THz,
            # Compressed channel
            'a_THz_m_s2':              a_THz,
            'a_vac_diff_m_s2':         a_vac_diff,       # PAPER_294
            'A_sc':                    A_sc,              # PAPER_295
            'a_super_m_s2':            a_super,           # PAPER_295
            'sigma_comp_m_s2':         sigma_comp,
            # Resonance channel
            'a_aether_m_s2':           a_aether,
            'a_u_g4i_m_s2':            a_u_g4i,
            'a_osc_m_s2':              a_osc,
            'a_quantum_m_s2':          a_quantum,
            'a_fluid_m_s2':            a_fluid,
            'a_exp_m_s2':              a_exp,
            'sigma_res_m_s2':          sigma_res,
            # PAPER_293 co-sum result
            'SCm':                     SCm,
            'g_CR_m_s2':               g_CR,
            'R_CR':                    R_CR,
            # PAPER_294 VDH observables
            'T_vac_s':                 T_vac,
            'E_0_over_E_vac':          E_0_over_E_vac,
            'V_over_hbar_m3_per_J_s':  V_over_hbar,
            # PAPER_295 f_DPM^2 scaling
            'a_super_x10_class_m_s2':  a_super_x10,
            'super_scaling_ratio':     a_super_x10 / a_super if a_super != 0.0 else 0.0,
            'papers':                  ['PAPER_293', 'PAPER_294', 'PAPER_295'],
            'system':                  'CR24 UQFF 2.0 � 25th C++ module, Systems 18-24 dual-channel',
            'session':                 83,
        }

    def compute(self, dataset: dict) -> dict:
        """Canonical UQFF compute. DPM-seeded: GM/r^2 is Step 10 projection, not seed.
        Chain: 0 -> grad(UA) -> DPM -> Ug1 -> Ug_family -> F_U -> M -> GM/r^2 (last).
        """
        import math
        M   = dataset.get('M_kg',   1.989e30)
        r   = dataset.get('r_m',    1.496e11)
        B   = dataset.get('B_T',    1e-4)
        t   = dataset.get('t_s',    0.0)
