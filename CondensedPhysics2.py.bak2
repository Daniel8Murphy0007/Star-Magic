class WSTPBridgeValidationCalculator_84A767D3:
    """PAPER_502: WSTP bridge validation -- wolfram.exe direct launch quality metric."""
    MAX_DRAIN_PACKETS = 20

    def compute(self, dataset: dict) -> dict:
        latency_ms = float(dataset.get('latency_ms', 1.0))
        packets    = float(dataset.get('packets_drained', 1.0))
        if packets > self.MAX_DRAIN_PACKETS:
            packets = self.MAX_DRAIN_PACKETS
        if latency_ms < 1e-12:
            latency_ms = 1.0
        drain_ratio = packets / self.MAX_DRAIN_PACKETS
        quality     = 1.0 / (latency_ms * (1.0 + drain_ratio))
        return {
            'primary_equations': [
                'quality = 1 / (latency_ms * (1 + drain_ratio))',
                f'quality = 1 / ({latency_ms} * (1 + {drain_ratio:.3f})) = {quality:.6e}',
                f'drain_ratio = {packets}/{self.MAX_DRAIN_PACKETS} = {drain_ratio:.3f}',
            ],
