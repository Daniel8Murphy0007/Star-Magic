# ========================================================================
class GrossPitaevskiiVortexSimulationCalculator:
    """
    CP4 #265 � PAPER_681 | UQFF GP vortex simulation � imaginary-time ground state, chemical potential, density profile
    CPP_MODULE: GrossPitaevskiiVortexSimulation
    """
    ENTRY   = 265
    PAPER   = "PAPER_681"
    CPP_MODULE = "GrossPitaevskiiVortexSimulation"
    UQFF_CONSTANTS = {
        "RHO_UA":  _RHO_VAC_UA,
        "RHO_SCM": _RHO_VAC_SCM,
        "F_TRZ":   0.1,
        "KAPPA":   0.0005,
        "SSQ":     0.57,
        "MU_J":    3.38e23,
        "GAMMA":   5.0e-5 / 86400.0,
    }
    PARAMETERS = [
        ('r_min_m', 'float', 1000000000.0, 'inner grid radius m'),
        ('r_max_m', 'float', 100000000000.0, 'outer grid radius m'),
        ('mass_kg', 'float', 8.548e+36, 'BH mass kg'),
        ('n_grid', 'int', 100, 'radial grid points'),
        ('n_steps', 'int', 50, 'imaginary-time steps'),
    ]
    PRIMARY_OUTPUT = "chemical_potential_eV"
    PRIMARY_INPUT  = "radius_m"

    def compute(self, params: dict = None) -> dict:
        if params is None:
            params = {}
        defaults = {'r_min_m': 1000000000.0, 'r_max_m': 100000000000.0, 'mass_kg': 8.548e+36, 'n_grid': 100, 'n_steps': 50}
        for k, v in defaults.items():
            params.setdefault(k, v)
        r_min_m = params.get('r_min_m', 1000000000.0)
        r_max_m = params.get('r_max_m', 100000000000.0)
        mass_kg = params.get('mass_kg', 8.548e+36)
        n_grid = params.get('n_grid', 100)
        n_steps = params.get('n_steps', 50)
        H0_SI = 2.184e-18
        M_UA  = HBAR*H0_SI/C**2
        G_UA  = 1.0e-10
        N_UA  = RHO_UA/(HBAR*H0_SI/C**2)
        # Thomas-Fermi approx: mu = G_UA*n_UA
        mu_UA = G_UA*N_UA
        xi    = HBAR/math.sqrt(2.0*M_UA*G_UA*N_UA)
        c_UA  = math.sqrt(G_UA*N_UA/M_UA)
        # Gravitational potential at r_min_m
        V_grav = -G*mass_kg*M_UA/r_min_m
        E_total = mu_UA + V_grav
        chemical_potential_eV = E_total / 1.602e-19
        result = {'chemical_potential_eV': chemical_potential_eV,
                   'healing_length_m': xi, 'mu_UA_J': mu_UA,
                   'TF_density_m3': N_UA, 'c_UA_m_s': c_UA}
        self._last = result
        return result

    def simulate(self, sweep: list = None, sweep_param: str = None) -> list:
        if sweep is None:
            sweep = [{}]
        results = []
        for p in sweep:
            results.append(self.compute(dict(p)))
        return results

    def add_mod(self, fn) -> None:
        if not hasattr(self, "_mods"):
            self._mods = []
        self._mods.append(fn)

    def update_from_file(self, filepath: str) -> None:
        import os
        if not os.path.isfile(filepath):
            return
        with open(filepath, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    try:
                        object.__setattr__(self, k.strip(), float(v.strip()))
                    except ValueError:
                        pass


